//@version=6
// ══════════════════════════════════════════════════════════════
// SENSEI PRO · ESCÁNER OB  v3.0
// Basado en el original Sensei + mejoras visuales
// ══════════════════════════════════════════════════════════════
indicator("Sensei Pro · Escáner OB", shorttitle="SenseiOB",
     overlay=true,
     max_boxes_count=500,
     max_lines_count=200,
     max_labels_count=100,
     max_bars_back=1500)

// ══════════════════════════════════════════════════════════════
// §1  INPUTS
// ══════════════════════════════════════════════════════════════
grp_struct  = "⚙ Estructura"
grp_ob      = "📦 Order Blocks"
grp_fvg     = "⚡ Fair Value Gaps"
grp_zones   = "🎯 Premium / Discount"
grp_panel   = "📊 Panel"
grp_retests = "🔁 Retests"

swing_len     = input.int   (10,  "Longitud swing",               minval=3,   maxval=50,  group=grp_struct)
atr_len       = input.int   (14,  "ATR período",                  minval=5,   maxval=50,  group=grp_struct)
consol_thresh = input.float (0.4, "Umbral consolidación (× ATR)", minval=0.1, maxval=2.0, step=0.1, group=grp_struct)
consol_bars   = input.int   (5,   "Ventana consolidación",        minval=2,   maxval=20,  group=grp_struct)
show_bos_lines= input.bool  (true,"Líneas BOS / CHoCH",           group=grp_struct)

show_obs      = input.bool  (true,  "Mostrar OBs",                group=grp_ob)
ob_extend     = input.int   (40,    "Extensión OB (velas)",       minval=5,  maxval=200, group=grp_ob)
ob_mitigation = input.string("Close","Mitigación al:",            options=["Close","Wick"], group=grp_ob)
col_ob_bull   = input.color (color.new(#00BCD4, 80), "Color demanda",  group=grp_ob)
col_ob_bear   = input.color (color.new(#FF5252, 80), "Color oferta",   group=grp_ob)
col_ob_mit    = input.color (color.new(#9E9E9E, 88), "Color mitigado", group=grp_ob)

show_fvg      = input.bool  (true, "Mostrar FVGs",                group=grp_fvg)
fvg_min_atr   = input.float (0.5,  "Tamaño mínimo FVG (× ATR)",  minval=0.1, maxval=5.0, step=0.1, group=grp_fvg)
col_fvg_bull  = input.color (color.new(#4CAF50, 88), "FVG alcista", group=grp_fvg)
col_fvg_bear  = input.color (color.new(#F44336, 88), "FVG bajista", group=grp_fvg)

show_pd       = input.bool  (true, "Zona Premium/Discount",       group=grp_zones)
show_eq       = input.bool  (true, "Línea de equilibrio",         group=grp_zones)

show_panel    = input.bool  (true, "Mostrar panel",               group=grp_panel)
panel_pos     = input.string("Bottom Right","Posición",           options=["Bottom Right","Bottom Left","Top Right","Top Left"], group=grp_panel)

retest_lb     = input.int   (300, "Lookback retests (barras)",    minval=50, maxval=1000, group=grp_retests)
bounce_atr    = input.float (1.0, "Bounce mínimo (× ATR)",       minval=0.3, maxval=5.0, step=0.1, group=grp_retests)
touch_atr     = input.float (0.5, "Tolerancia toque (× ATR)",    minval=0.1, maxval=2.0, step=0.1, group=grp_retests)

// ══════════════════════════════════════════════════════════════
// §2  BASE
// ══════════════════════════════════════════════════════════════
atr_val = ta.atr(atr_len)
vol_ma  = ta.sma(volume, 20)
vol_rel = nz(volume / vol_ma, 1.0)

ph = ta.pivothigh(high, swing_len, swing_len)
pl = ta.pivotlow (low,  swing_len, swing_len)

// ══════════════════════════════════════════════════════════════
// §3  ESTRUCTURA: HH / HL / LL / LH → TENDENCIA
// ══════════════════════════════════════════════════════════════
var float last_ph  = na
var float prev_ph  = na
var float last_pl  = na
var float prev_pl  = na

var float hh_val   = na
var float hl_val   = na
var float ll_val   = na
var float lh_val   = na

var int   trend    = 0
var int   bos_dir  = 0
var bool  was_choch = false

if not na(ph)
    prev_ph := last_ph
    last_ph := ph

if not na(pl)
    prev_pl := last_pl
    last_pl := pl

bool new_hh = not na(ph) and not na(prev_ph) and last_ph > prev_ph
bool new_lh = not na(ph) and not na(prev_ph) and last_ph < prev_ph
bool new_hl = not na(pl) and not na(prev_pl) and last_pl > prev_pl
bool new_ll = not na(pl) and not na(prev_pl) and last_pl < prev_pl

if (new_hh or new_hl) and not (new_ll or new_lh)
    was_choch := trend == -1
    bos_dir   := 1
    trend     := 1
    hh_val    := last_ph
    hl_val    := last_pl

if (new_ll or new_lh) and not (new_hh or new_hl)
    was_choch := trend == 1
    bos_dir   := -1
    trend     := -1
    ll_val    := last_pl
    lh_val    := last_ph

// Racha
var int racha      = 0
var int prev_trend = 0
bool pivot_seen = not na(ph) or not na(pl)
if trend != prev_trend and trend != 0
    racha := 1
    prev_trend := trend
else if pivot_seen and trend != 0
    racha += 1

// Líneas BOS / CHoCH
var line bos_line   = na
var line choch_line = na

if show_bos_lines
    if new_hh and not was_choch
        if not na(bos_line)
            line.delete(bos_line)
        bos_line := line.new(bar_index - swing_len, hh_val, bar_index, hh_val,
             color=color.new(color.green, 30), width=1, style=line.style_dashed)
    if new_ll and not was_choch
        if not na(bos_line)
            line.delete(bos_line)
        bos_line := line.new(bar_index - swing_len, ll_val, bar_index, ll_val,
             color=color.new(color.red, 30), width=1, style=line.style_dashed)
    if was_choch and new_hh
        if not na(choch_line)
            line.delete(choch_line)
        choch_line := line.new(bar_index - swing_len, hh_val, bar_index, hh_val,
             color=color.new(color.teal, 20), width=2, style=line.style_dotted)
    if was_choch and new_ll
        if not na(choch_line)
            line.delete(choch_line)
        choch_line := line.new(bar_index - swing_len, ll_val, bar_index, ll_val,
             color=color.new(color.purple, 20), width=2, style=line.style_dotted)

// ══════════════════════════════════════════════════════════════
// §4  ORDER BLOCKS
// Igual que el original: un OB activo por dirección (var float).
// Además dibujamos cajas adicionales históricas para visualización.
// ══════════════════════════════════════════════════════════════
var float ob_bull_top = na
var float ob_bull_bot = na
var int   ob_bull_bar = na
var box   ob_bull_box = na

var float ob_bear_top = na
var float ob_bear_bot = na
var int   ob_bear_bar = na
var box   ob_bear_box = na

// Detectar OB bull (última vela bajista antes del nuevo HH)
if new_hh
    for i = swing_len to swing_len + 15
        if close[i] < open[i]
            ob_bull_top := math.max(open[i], close[i])
            ob_bull_bot := math.min(open[i], close[i])
            ob_bull_bar := bar_index - i
            if show_obs
                if not na(ob_bull_box)
                    box.delete(ob_bull_box)
                ob_bull_box := box.new(
                     left=ob_bull_bar, top=ob_bull_top,
                     right=bar_index + ob_extend, bottom=ob_bull_bot,
                     bgcolor=col_ob_bull,
                     border_color=color.new(#00BCD4, 50), border_width=1)
            break

// Detectar OB bear (última vela alcista antes del nuevo LL)
if new_ll
    for i = swing_len to swing_len + 15
        if close[i] > open[i]
            ob_bear_top := math.max(open[i], close[i])
            ob_bear_bot := math.min(open[i], close[i])
            ob_bear_bar := bar_index - i
            if show_obs
                if not na(ob_bear_box)
                    box.delete(ob_bear_box)
                ob_bear_box := box.new(
                     left=ob_bear_bar, top=ob_bear_top,
                     right=bar_index + ob_extend, bottom=ob_bear_bot,
                     bgcolor=col_ob_bear,
                     border_color=color.new(#FF5252, 50), border_width=1)
            break

// Extender cajas y detectar mitigación
if barstate.isconfirmed
    if not na(ob_bull_box)
        box.set_right(ob_bull_box, bar_index + ob_extend)
    if not na(ob_bear_box)
        box.set_right(ob_bear_box, bar_index + ob_extend)

    // Mitigación OB bull
    if not na(ob_bull_top)
        bool mit_bull = ob_mitigation == "Close" ? close < ob_bull_bot : low < ob_bull_bot
        if mit_bull
            if not na(ob_bull_box)
                box.set_bgcolor(ob_bull_box, col_ob_mit)
                box.set_border_color(ob_bull_box, color.new(color.gray, 60))
            ob_bull_top := na
            ob_bull_bot := na

    // Mitigación OB bear
    if not na(ob_bear_top)
        bool mit_bear = ob_mitigation == "Close" ? close > ob_bear_top : high > ob_bear_top
        if mit_bear
            if not na(ob_bear_box)
                box.set_bgcolor(ob_bear_box, col_ob_mit)
                box.set_border_color(ob_bear_box, color.new(color.gray, 60))
            ob_bear_top := na
            ob_bear_bot := na

// ══════════════════════════════════════════════════════════════
// §5  FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════
var array<box> fvg_arr = array.new<box>()

if show_fvg and barstate.isconfirmed and not na(atr_val) and atr_val > 0
    // FVG alcista: low de vela actual > high de 2 velas atrás
    if low > high[2] and (low - high[2]) >= atr_val * fvg_min_atr
        fvg_arr.push(box.new(bar_index - 2, low, bar_index + ob_extend, high[2],
             bgcolor=col_fvg_bull, border_color=color.new(color.green, 70), border_width=1))

    // FVG bajista: high de vela actual < low de 2 velas atrás
    if high < low[2] and (low[2] - high) >= atr_val * fvg_min_atr
        fvg_arr.push(box.new(bar_index - 2, low[2], bar_index + ob_extend, high,
             bgcolor=col_fvg_bear, border_color=color.new(color.red, 70), border_width=1))

    // Purgar FVGs viejos
    while fvg_arr.size() > 25
        b = fvg_arr.shift()
        if not na(b)
            box.delete(b)

    // Extender FVGs activos — con guard
    int fvg_sz = fvg_arr.size()
    if fvg_sz > 0
        for i = 0 to fvg_sz - 1
            bx = fvg_arr.get(i)
            if not na(bx)
                box.set_right(bx, bar_index + ob_extend)

// ══════════════════════════════════════════════════════════════
// §6  ZONA PREMIUM / DISCOUNT + EQUILIBRIO
// ══════════════════════════════════════════════════════════════
var line eq_line  = na
var box  prem_box = na
var box  disc_box = na

if barstate.islast and show_pd
    float rh = trend == 1 ? nz(hh_val) : nz(lh_val)
    float rl = trend == 1 ? nz(hl_val) : nz(ll_val)
    float eq = (rh + rl) / 2.0

    if rh > rl and rh != 0.0
        if show_eq
            if not na(eq_line)
                line.delete(eq_line)
            eq_line := line.new(bar_index - 60, eq, bar_index + 5, eq,
                 color=color.new(color.white, 40), width=1, style=line.style_dashed)
        if not na(prem_box)
            box.delete(prem_box)
        prem_box := box.new(bar_index - 60, rh, bar_index + 5, eq,
             bgcolor=color.new(color.red, 93), border_color=na)
        if not na(disc_box)
            box.delete(disc_box)
        disc_box := box.new(bar_index - 60, eq, bar_index + 5, rl,
             bgcolor=color.new(color.green, 93), border_color=na)

// ══════════════════════════════════════════════════════════════
// §7  FACTORES F1–F5 → TASA DE CONTINUACIÓN
// ══════════════════════════════════════════════════════════════
float f1 = 0.5
if trend == 1 and not na(hh_val) and not na(hl_val) and not na(atr_val) and atr_val > 0
    f1 := math.min((hh_val - hl_val) / (atr_val * 10.0), 1.0)
if trend == -1 and not na(lh_val) and not na(ll_val) and not na(atr_val) and atr_val > 0
    f1 := math.min((lh_val - ll_val) / (atr_val * 10.0), 1.0)

float f2 = 0.5
if trend == 1 and not na(hh_val) and not na(hl_val)
    float rng = hh_val - hl_val
    if rng > 0
        f2 := 1.0 - math.max(math.min((close - hl_val) / rng, 1.0), 0.0)
if trend == -1 and not na(lh_val) and not na(ll_val)
    float rng = lh_val - ll_val
    if rng > 0
        f2 := math.max(math.min((close - ll_val) / rng, 1.0), 0.0)

float f3 = 0.5
if bos_dir != 0
    if was_choch
        f3 := 0.65
    else if bos_dir == trend
        f3 := 1.0
    else
        f3 := 0.0

int consol_count = 0
if not na(atr_val) and atr_val > 0
    for i = 0 to consol_bars - 1
        if (high[i] - low[i]) < (atr_val * consol_thresh)
            consol_count += 1
float f4 = not na(atr_val) and atr_val > 0 ? 1.0 - float(consol_count) / float(consol_bars) : 0.5

float f5 = math.min(vol_rel / 2.0, 1.0)

float tasa = math.round((f1*0.30 + f2*0.20 + f3*0.25 + f4*0.15 + f5*0.10) * 100)

string tasa_class = tasa > 65 ? "ALTO" : tasa >= 50 ? "MEDIO" : "BAJO"
color  tasa_col   = tasa > 65 ? color.new(#26A69A, 10) : tasa >= 50 ? color.new(color.orange, 10) : color.new(color.red, 10)

// ══════════════════════════════════════════════════════════════
// §8  PROBABILIDADES DE RETEST (igual que el original)
// ══════════════════════════════════════════════════════════════
float lvl_bos_up = hh_val
float lvl_ob_up  = not na(ob_bull_top) and not na(ob_bull_bot) ? (ob_bull_top + ob_bull_bot) / 2.0 : na
float lvl_bos_dn = ll_val
float lvl_ob_dn  = not na(ob_bear_top) and not na(ob_bear_bot) ? (ob_bear_top + ob_bear_bot) / 2.0 : na

float tol_r = nz(atr_val) * touch_atr
float bnc_r = nz(atr_val) * bounce_atr

calc_retest(float nivel, int direction) =>
    int touches = 0
    int held    = 0
    if not na(nivel) and tol_r > 0 and bnc_r > 0
        for i = 1 to retest_lb
            bool touch = low[i] <= nivel + tol_r and high[i] >= nivel - tol_r
            if touch
                touches += 1
                float best = 0.0
                for j = 0 to 4
                    if i >= j
                        best := direction == 1 ?
                             math.max(best, high[i-j] - nivel) :
                             math.max(best, nivel - low[i-j])
                if best >= bnc_r
                    held += 1
    [touches, held]

[t_bos_up, h_bos_up] = calc_retest(lvl_bos_up,  1)
[t_ob_up,  h_ob_up]  = calc_retest(lvl_ob_up,   1)
[t_bos_dn, h_bos_dn] = calc_retest(lvl_bos_dn, -1)
[t_ob_dn,  h_ob_dn]  = calc_retest(lvl_ob_dn,  -1)

float pct_bos_up = t_bos_up >= 3 ? math.round(float(h_bos_up) / float(t_bos_up) * 100) : 50.0
float pct_ob_up  = t_ob_up  >= 3 ? math.round(float(h_ob_up)  / float(t_ob_up)  * 100) : 50.0
float pct_bos_dn = t_bos_dn >= 3 ? math.round(float(h_bos_dn) / float(t_bos_dn) * 100) : 50.0
float pct_ob_dn  = t_ob_dn  >= 3 ? math.round(float(h_ob_dn)  / float(t_ob_dn)  * 100) : 50.0

classify(float pct) =>
    pct > 65 ? "ALTO" : pct >= 50 ? "MEDIO" : "BAJO"
col_class(float pct) =>
    pct > 65 ? color.new(#26A69A, 20) : pct >= 50 ? color.new(color.orange, 20) : color.new(color.red, 20)

// ══════════════════════════════════════════════════════════════
// §9  CALIFICACIÓN GLOBAL
// ══════════════════════════════════════════════════════════════
float best_retest = trend == 1  ? math.max(pct_ob_up, pct_bos_up) :
                    trend == -1 ? math.max(pct_ob_dn, pct_bos_dn) : 50.0
float combined    = (tasa + best_retest) / 2.0

string calificacion = combined > 70 ? "🔥🔥🔥 ÓPTIMO"  :
                      combined > 60 ? "🔥🔥 BUENO"      :
                      combined > 50 ? "🔥 ACEPTABLE"    : "— ESPERAR"

// Barra de progreso
f_bar(float pct, int w) =>
    int f = int(pct / 100.0 * w)
    string s = ""
    for _i = 0 to f - 1
        s := s + "█"
    for _i = 0 to w - f - 1
        s := s + "░"
    s

// ══════════════════════════════════════════════════════════════
// §10  PANEL
// ══════════════════════════════════════════════════════════════
f_pos(string p) =>
    p == "Top Left"     ? position.top_left    :
     p == "Top Right"   ? position.top_right   :
     p == "Bottom Left" ? position.bottom_left :
                          position.bottom_right

var table tbl = na

if show_panel and barstate.islast
    if not na(tbl)
        table.delete(tbl)

    tbl := table.new(
         position    = f_pos(panel_pos),
         columns     = 2, rows = 17,
         bgcolor     = color.new(#0D1117, 5),
         border_color= color.new(#30363D, 60), border_width=1,
         frame_color = color.new(#58A6FF, 40),  frame_width=2)

    C_HDR  = color.new(#161B22, 10)
    C_CELL = color.new(#0D1117, 20)
    C_SEP  = color.new(#21262D, 50)
    C_DIM  = color.new(#8B949E, 0)
    C_WHT  = color.white

    // Título
    table.cell(tbl,0,0,"SENSEI PRO · OB SCANNER",
         text_color=color.new(#58A6FF,0), text_size=size.small,
         bgcolor=C_HDR, text_halign=text.align_center)
    table.merge_cells(tbl,0,0,1,0)

    // Tendencia
    color  t_bg  = color.new(#6E7681,30)
    string t_str = "◆  NEUTRAL"
    if trend == 1
        t_bg  := color.new(#26A69A,25)
        t_str := "▲  ALCISTA"
    else if trend == -1
        t_bg  := color.new(#EF5350,25)
        t_str := "▼  BAJISTA"
    table.cell(tbl,0,1,"TENDENCIA",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,1,t_str,text_color=C_WHT,text_size=size.small,bgcolor=t_bg,text_halign=text.align_center)

    // Racha
    table.cell(tbl,0,2,"RACHA SWING",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,2,str.tostring(racha)+" pivots",text_color=C_WHT,text_size=size.small,bgcolor=C_CELL,text_halign=text.align_center)

    // Sep
    table.cell(tbl,0,3,"── FACTORES ──",text_color=C_DIM,text_size=size.tiny,bgcolor=C_SEP,text_halign=text.align_center)
    table.merge_cells(tbl,0,3,1,3)

    // Tasa de continuación
    table.cell(tbl,0,4,"TASA CONT.",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,4,f_bar(tasa,10)+"  "+str.tostring(int(tasa))+"%  "+tasa_class,
         text_color=C_WHT,text_size=size.tiny,bgcolor=tasa_col,text_halign=text.align_center)

    // Volumen relativo
    v_col = vol_rel > 1.5 ? color.new(color.green,30) : vol_rel > 0.8 ? color.new(#455A64,30) : color.new(color.red,50)
    table.cell(tbl,0,5,"VOL. RELATIVO",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,5,str.tostring(math.round(vol_rel*100)/100.0)+"x",
         text_color=C_WHT,text_size=size.small,bgcolor=v_col,text_halign=text.align_center)

    // Sep arriba
    table.cell(tbl,0,6,"── RETESTS ARRIBA ──",text_color=color.new(#58A6FF,20),text_size=size.tiny,bgcolor=color.new(#0D2A4A,50),text_halign=text.align_center)
    table.merge_cells(tbl,0,6,1,6)

    table.cell(tbl,0,7,"BOS ARRIBA",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,7,f_bar(pct_bos_up,10)+"  "+str.tostring(int(pct_bos_up))+"%  "+classify(pct_bos_up),
         text_color=C_WHT,text_size=size.tiny,bgcolor=col_class(pct_bos_up),text_halign=text.align_center)

    table.cell(tbl,0,8,"OB DEMANDA",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,8,f_bar(pct_ob_up,10)+"  "+str.tostring(int(pct_ob_up))+"%  "+classify(pct_ob_up),
         text_color=C_WHT,text_size=size.tiny,bgcolor=col_class(pct_ob_up),text_halign=text.align_center)

    // Sep abajo
    table.cell(tbl,0,9,"── RETESTS ABAJO ──",text_color=color.new(#FF5252,20),text_size=size.tiny,bgcolor=color.new(#2D0D0D,50),text_halign=text.align_center)
    table.merge_cells(tbl,0,9,1,9)

    table.cell(tbl,0,10,"BOS ABAJO",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,10,f_bar(pct_bos_dn,10)+"  "+str.tostring(int(pct_bos_dn))+"%  "+classify(pct_bos_dn),
         text_color=C_WHT,text_size=size.tiny,bgcolor=col_class(pct_bos_dn),text_halign=text.align_center)

    table.cell(tbl,0,11,"OB OFERTA",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,11,f_bar(pct_ob_dn,10)+"  "+str.tostring(int(pct_ob_dn))+"%  "+classify(pct_ob_dn),
         text_color=C_WHT,text_size=size.tiny,bgcolor=col_class(pct_ob_dn),text_halign=text.align_center)

    // Sep niveles OB activos
    table.cell(tbl,0,12,"── OBs ACTIVOS ──",text_color=C_DIM,text_size=size.tiny,bgcolor=C_SEP,text_halign=text.align_center)
    table.merge_cells(tbl,0,12,1,12)

    bull_str = not na(ob_bull_top) ? str.tostring(math.round(ob_bull_bot*10000)/10000.0)+" – "+str.tostring(math.round(ob_bull_top*10000)/10000.0) : "—"
    bear_str = not na(ob_bear_top) ? str.tostring(math.round(ob_bear_bot*10000)/10000.0)+" – "+str.tostring(math.round(ob_bear_top*10000)/10000.0) : "—"

    table.cell(tbl,0,13,"🟢 DEMANDA",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,13,bull_str,text_color=color.new(#00BCD4,0),text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_center)

    table.cell(tbl,0,14,"🔴 OFERTA",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,14,bear_str,text_color=color.new(#FF5252,0),text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_center)

    // Sep calificación
    table.cell(tbl,0,15,"──────────────────",text_color=C_DIM,text_size=size.tiny,bgcolor=C_SEP,text_halign=text.align_center)
    table.merge_cells(tbl,0,15,1,15)

    cal_col = combined > 70 ? color.new(#FFD700,20) :
              combined > 60 ? color.new(#FFA000,20) :
              combined > 50 ? color.new(#455A64,20) : color.new(#37474F,40)
    table.cell(tbl,0,16,"SEÑAL GLOBAL",text_color=C_DIM,text_size=size.tiny,bgcolor=C_CELL,text_halign=text.align_left)
    table.cell(tbl,1,16,calificacion,text_color=color.new(#FFD700,0),text_size=size.small,bgcolor=cal_col,text_halign=text.align_center)

else if not show_panel and barstate.islast and not na(tbl)
    table.delete(tbl)
    tbl := na

// ══════════════════════════════════════════════════════════════
// §11  PLOTS DE ESTRUCTURA
// ══════════════════════════════════════════════════════════════
plot(trend == 1  and not na(hh_val) ? hh_val : na, "HH", color=color.new(#26A69A,40), linewidth=1, style=plot.style_stepline)
plot(trend == 1  and not na(hl_val) ? hl_val : na, "HL", color=color.new(#26A69A,60), linewidth=1, style=plot.style_stepline)
plot(trend == -1 and not na(ll_val) ? ll_val : na, "LL", color=color.new(#EF5350,40), linewidth=1, style=plot.style_stepline)
plot(trend == -1 and not na(lh_val) ? lh_val : na, "LH", color=color.new(#EF5350,60), linewidth=1, style=plot.style_stepline)

// BOS / CHoCH
plotshape(new_hh and not was_choch,"BOS ↑",shape.triangleup,  location.belowbar,color.new(#26A69A,20),size=size.tiny,text="BOS",textcolor=color.new(#26A69A,20))
plotshape(new_ll and not was_choch,"BOS ↓",shape.triangledown,location.abovebar,color.new(#EF5350,20),size=size.tiny,text="BOS",textcolor=color.new(#EF5350,20))
plotshape(was_choch and new_hh,"CHoCH ↑",shape.diamond,location.belowbar,color.new(color.teal,10),  size=size.small,text="CHoCH",textcolor=color.new(color.teal,10))
plotshape(was_choch and new_ll,"CHoCH ↓",shape.diamond,location.abovebar,color.new(color.purple,10),size=size.small,text="CHoCH",textcolor=color.new(color.purple,10))

// Señales de entrada (precio dentro del OB activo + tasa alta)
float tol_e = nz(atr_val) * touch_atr
bool long_sig  = trend == 1  and tasa > 65 and not na(ob_bull_top) and
                 low <= ob_bull_top + tol_e and high >= ob_bull_bot - tol_e
bool short_sig = trend == -1 and tasa > 65 and not na(ob_bear_top) and
                 high >= ob_bear_bot - tol_e and low <= ob_bear_top + tol_e

plotshape(long_sig,  "LONG ✦", shape.arrowup,   location.belowbar, color.new(#00E5FF,0), size=size.normal)
plotshape(short_sig, "SHORT ✦",shape.arrowdown,  location.abovebar, color.new(#FF1744,0), size=size.normal)

// Hidden para alertas
plot(tasa,    "TASA_ALERT",    display=display.none)
plot(combined,"COMBINED_ALERT",display=display.none)

// ══════════════════════════════════════════════════════════════
// §12  ALERTAS
// ══════════════════════════════════════════════════════════════
alertcondition(long_sig,  "🟢 LONG — OB Demanda", "Sensei Pro: LONG en OB demanda | Tasa: {{plot(\"TASA_ALERT\")}}% | Score: {{plot(\"COMBINED_ALERT\")}}%")
alertcondition(short_sig, "🔴 SHORT — OB Oferta",  "Sensei Pro: SHORT en OB oferta | Tasa: {{plot(\"TASA_ALERT\")}}% | Score: {{plot(\"COMBINED_ALERT\")}}%")
alertcondition(was_choch and new_hh,"🔄 CHoCH Alcista","Sensei Pro: CHoCH alcista detectado")
alertcondition(was_choch and new_ll,"🔄 CHoCH Bajista","Sensei Pro: CHoCH bajista detectado")
alertcondition(tasa < 40,"⚠ Tasa baja","Sensei Pro: Tasa BAJA ({{plot(\"TASA_ALERT\")}}%) — No operar")
