//@version=5
strategy("El Sensei OB Strategy Pro", shorttitle="SenseiPro", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=2,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, max_bars_back=500, calc_on_every_tick=false)

// =============================================================================
// INPUTS
// =============================================================================

// ⚙️ Estructura
leftBars   = input.int(10, "Left Bars",  minval=1, maxval=50, group="⚙️ Estructura")
rightBars  = input.int(10, "Right Bars", minval=1, maxval=50, group="⚙️ Estructura")

// 📦 Order Blocks
maxOBs     = input.int(5,  "Max OBs to Track",  minval=1, maxval=20, group="📦 Order Blocks")
obLookback = input.int(90, "OB Lookback (zones)", minval=10, maxval=200, group="📦 Order Blocks")

// 📊 Filtros
minContinuationRate = input.int(55, "Min Continuation Rate (%)", minval=0, maxval=100, group="📊 Filtros")
allowNeutral        = input.bool(false, "Allow Neutral Zone (45–55%)", group="📊 Filtros")

// 🕐 Tiempo
useTimeFilter  = input.bool(true,    "Use Time Filter",             group="🕐 Tiempo")
tradeSession   = input.session("0700-1600", "Trade Session",        group="🕐 Tiempo")
maxTradesDay   = input.int(3,    "Max Trades Per Day", minval=1,    group="🕐 Tiempo")
cooldownBars   = input.int(10,   "Cooldown Bars Between Trades",    group="🕐 Tiempo")

// 🎯 Entradas
entryType   = input.string("Touch", "Entry Type", options=["Touch", "Close"], group="🎯 Entradas")
useMTFFilter = input.bool(true,  "Use MTF Trend Filter",           group="🎯 Entradas")
mtfTF        = input.timeframe("60", "MTF Timeframe",              group="🎯 Entradas")

// 🛑 Stop Loss
slType  = input.string("Zone", "SL Type", options=["Zone", "ATR"], group="🛑 Stop Loss")
atrMult = input.float(1.5, "ATR Multiplier (for ATR SL)", minval=0.1, step=0.1, group="🛑 Stop Loss")
atrLen  = input.int(14,   "ATR Length",                   minval=1,             group="🛑 Stop Loss")

// ✅ Take Profit
tpType  = input.string("RR", "TP Type", options=["RR", "Swing", "Zone"], group="✅ Take Profit")
rrRatio = input.float(2.0, "R:R Ratio (for RR TP)", minval=0.1, step=0.1,  group="✅ Take Profit")

// ⚡ Avanzado
useBreakEven = input.bool(false, "Use Break-Even",              group="⚡ Avanzado")
beRR         = input.float(1.0, "Break-Even at X * Risk",       group="⚡ Avanzado", minval=0.1, step=0.1)
useTrailing  = input.bool(false, "Use Trailing Stop",           group="⚡ Avanzado")
trailATR     = input.float(2.0, "Trail Stop (ATR multiplier)",  group="⚡ Avanzado", minval=0.1, step=0.1)

// =============================================================================
// MARKET STRUCTURE – PIVOTS
// =============================================================================

ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low,   leftBars, rightBars)

// Pivot history arrays (bar index + price)
var array<int>   phBars  = array.new_int()
var array<float> phPrice = array.new_float()
var array<int>   plBars  = array.new_int()
var array<float> plPrice = array.new_float()

if not na(ph)
    array.push(phBars,  bar_index - rightBars)
    array.push(phPrice, ph)
    if array.size(phBars) > 100
        array.shift(phBars)
        array.shift(phPrice)

if not na(pl)
    array.push(plBars,  bar_index - rightBars)
    array.push(plPrice, pl)
    if array.size(plBars) > 100
        array.shift(plBars)
        array.shift(plPrice)

// =============================================================================
// HH / HL / LH / LL TRACKING
// =============================================================================

var float lastPH  = na
var float prevPH  = na
var float lastPL  = na
var float prevPL  = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph

if not na(pl)
    prevPL := lastPL
    lastPL := pl

bullishTrendLocal = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH > prevPH and lastPL > prevPL
bearishTrendLocal = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL) and lastPH < prevPH and lastPL < prevPL

// =============================================================================
// BOS / CHoCH DETECTION
// =============================================================================

var float lastBullBOS = na
var float lastBearBOS = na
var bool  newBullBOS  = false
var bool  newBearBOS  = false

newBullBOS := false
newBearBOS := false

if array.size(phPrice) >= 2
    prevHigh = array.get(phPrice, array.size(phPrice) - 2)
    if close > prevHigh and not na(prevHigh)
        if not na(lastBullBOS) and prevHigh > lastBullBOS
            newBullBOS := true
            lastBullBOS := prevHigh
        else if na(lastBullBOS)
            newBullBOS := true
            lastBullBOS := prevHigh

if array.size(plPrice) >= 2
    prevLow = array.get(plPrice, array.size(plPrice) - 2)
    if close < prevLow and not na(prevLow)
        if not na(lastBearBOS) and prevLow < lastBearBOS
            newBearBOS := true
            lastBearBOS := prevLow
        else if na(lastBearBOS)
            newBearBOS := true
            lastBearBOS := prevLow

// =============================================================================
// ORDER BLOCK DETECTION
// =============================================================================

// OB storage: top, bottom, bar, active flag, bullish flag
var array<float> obTop      = array.new_float()
var array<float> obBottom   = array.new_float()
var array<int>   obBarIdx   = array.new_int()
var array<bool>  obActive   = array.new_bool()
var array<bool>  obIsBull   = array.new_bool()

// Helper: find last bearish candle before BOS bar
findLastBearCandle(bosBar) =>
    result_top    = float(na)
    result_bottom = float(na)
    result_bar    = int(na)
    startBar = math.max(0, bosBar - 30)
    for i = bosBar to startBar
        if close[bar_index - i] < open[bar_index - i]
            result_top    := open[bar_index - i]
            result_bottom := close[bar_index - i]
            result_bar    := i
            break
    [result_top, result_bottom, result_bar]

// Helper: find last bullish candle before BOS bar
findLastBullCandle(bosBar) =>
    result_top    = float(na)
    result_bottom = float(na)
    result_bar    = int(na)
    startBar = math.max(0, bosBar - 30)
    for i = bosBar to startBar
        if close[bar_index - i] > open[bar_index - i]
            result_top    := open[bar_index - i]
            result_bottom := close[bar_index - i]
            result_bar    := i
            break
    [result_top, result_bottom, result_bar]

// Add bullish OB on bullish BOS
if newBullBOS
    [obT, obB, obBr] = findLastBearCandle(rightBars)
    if not na(obT)
        array.push(obTop,    obT)
        array.push(obBottom, obB)
        array.push(obBarIdx, bar_index - obBr)
        array.push(obActive, true)
        array.push(obIsBull, true)
        if array.size(obTop) > maxOBs * 4
            array.shift(obTop)
            array.shift(obBottom)
            array.shift(obBarIdx)
            array.shift(obActive)
            array.shift(obIsBull)

// Add bearish OB on bearish BOS
if newBearBOS
    [obT, obB, obBr] = findLastBullCandle(rightBars)
    if not na(obT)
        array.push(obTop,    obT)
        array.push(obBottom, obB)
        array.push(obBarIdx, bar_index - obBr)
        array.push(obActive, true)
        array.push(obIsBull, false)
        if array.size(obTop) > maxOBs * 4
            array.shift(obTop)
            array.shift(obBottom)
            array.shift(obBarIdx)
            array.shift(obActive)
            array.shift(obIsBull)

// Invalidate OBs: bullish OB invalidated if price closes below obBottom; bearish OB if price closes above obTop
if array.size(obTop) > 0
    for i = 0 to array.size(obTop) - 1
        if array.get(obActive, i)
            if array.get(obIsBull, i)
                if close < array.get(obBottom, i)
                    array.set(obActive, i, false)
            else
                if close > array.get(obTop, i)
                    array.set(obActive, i, false)

// =============================================================================
// CONTINUATION RATE CALCULATION
// =============================================================================

calcContinuationRate(isBull) =>
    total   = 0
    held    = 0
    count   = 0
    size    = array.size(obTop)
    if size > 0
        for i = 0 to size - 1
            if array.get(obIsBull, i) == isBull
                count += 1
                total += 1
                if array.get(obActive, i)
                    held += 1
                if count >= obLookback
                    break
    rate = total > 0 ? math.round(held / total * 100) : 50
    rate

bullContRate = calcContinuationRate(true)
bearContRate = calcContinuationRate(false)

// =============================================================================
// MTF TREND
// =============================================================================

mtfClose = request.security(syminfo.tickerid, mtfTF, close, lookahead=barmerge.lookahead_off)
mtfHigh  = request.security(syminfo.tickerid, mtfTF, high,  lookahead=barmerge.lookahead_off)
mtfLow   = request.security(syminfo.tickerid, mtfTF, low,   lookahead=barmerge.lookahead_off)

mtfEMA20 = request.security(syminfo.tickerid, mtfTF, ta.ema(close, 20), lookahead=barmerge.lookahead_off)
mtfEMA50 = request.security(syminfo.tickerid, mtfTF, ta.ema(close, 50), lookahead=barmerge.lookahead_off)

mtfBullish = mtfClose > mtfEMA20 and mtfEMA20 > mtfEMA50
mtfBearish = mtfClose < mtfEMA20 and mtfEMA20 < mtfEMA50
mtfNeutral = not mtfBullish and not mtfBearish

// =============================================================================
// ATR
// =============================================================================

atrValue = ta.atr(atrLen)

// =============================================================================
// TIME FILTER
// =============================================================================

inSession = useTimeFilter ? not na(time(timeframe.period, tradeSession)) : true

// =============================================================================
// TRADE TRACKING
// =============================================================================

var int  tradesThisDay  = 0
var int  lastTradeDay   = na
var int  lastTradeBar   = na
var bool inLong         = false
var bool inShort        = false

currentDay = dayofmonth

// Reset daily counter
if na(lastTradeDay) or currentDay != lastTradeDay
    tradesThisDay := 0
    lastTradeDay  := currentDay

// Update in-trade status
inLong  := strategy.position_size > 0
inShort := strategy.position_size < 0

canTrade = tradesThisDay < maxTradesDay and inSession and (na(lastTradeBar) or bar_index - lastTradeBar >= cooldownBars)

// =============================================================================
// FIND ACTIVE OB TOUCHING PRICE
// =============================================================================

// Returns index of nearest active bullish OB that price is touching/inside
findActiveBullOB() =>
    result = -1
    bestDist = float(na)
    size = array.size(obTop)
    if size > 0
        for i = size - 1 to 0
            if array.get(obActive, i) and array.get(obIsBull, i)
                obT = array.get(obTop, i)
                obB = array.get(obBottom, i)
                touching = low <= obT and high >= obB
                if touching
                    dist = math.abs(close - obT)
                    if na(bestDist) or dist < bestDist
                        bestDist := dist
                        result   := i
    result

findActiveBearOB() =>
    result = -1
    bestDist = float(na)
    size = array.size(obTop)
    if size > 0
        for i = size - 1 to 0
            if array.get(obActive, i) and not array.get(obIsBull, i)
                obT = array.get(obTop, i)
                obB = array.get(obBottom, i)
                touching = high >= obB and low <= obT
                if touching
                    dist = math.abs(close - obB)
                    if na(bestDist) or dist < bestDist
                        bestDist := dist
                        result   := i
    result

activeBullOBIdx = findActiveBullOB()
activeBearOBIdx = findActiveBearOB()

hasBullOB = activeBullOBIdx >= 0
hasBearOB = activeBearOBIdx >= 0

// OB zone values for current touching OB
bullOBTop    = hasBullOB ? array.get(obTop,    activeBullOBIdx) : float(na)
bullOBBottom = hasBullOB ? array.get(obBottom, activeBullOBIdx) : float(na)
bearOBTop    = hasBearOB ? array.get(obTop,    activeBearOBIdx) : float(na)
bearOBBottom = hasBearOB ? array.get(obBottom, activeBearOBIdx) : float(na)

// =============================================================================
// ENTRY CONDITION HELPERS
// =============================================================================

rateOkLong  = bullContRate >= minContinuationRate
rateOkShort = bearContRate >= minContinuationRate

// Neutralization check: if rate is 45-55% it's neutral — only allow if override
neutralLong  = bullContRate >= 45 and bullContRate <= 55
neutralShort = bearContRate >= 45 and bearContRate <= 55

neutralOkLong  = allowNeutral or not neutralLong
neutralOkShort = allowNeutral or not neutralShort

mtfOkLong  = not useMTFFilter or (mtfBullish or mtfNeutral)
mtfOkShort = not useMTFFilter or (mtfBearish or mtfNeutral)

// Entry price condition based on type
touchCondLong  = entryType == "Touch" ? low <= bullOBTop : (close >= bullOBBottom and close <= bullOBTop)
touchCondShort = entryType == "Touch" ? high >= bearOBBottom : (close >= bearOBBottom and close <= bearOBTop)

longCondition  = bullishTrendLocal and hasBullOB and touchCondLong  and rateOkLong  and neutralOkLong  and mtfOkLong  and canTrade and not inLong  and not inShort
shortCondition = bearishTrendLocal and hasBearOB and touchCondShort and rateOkShort and neutralOkShort and mtfOkShort and canTrade and not inLong  and not inShort

// =============================================================================
// STOP LOSS CALCULATION
// =============================================================================

calcSL(isLong, obT, obB, entryPx) =>
    sl = float(na)
    if isLong
        sl := slType == "Zone" ? obB : entryPx - atrValue * atrMult
    else
        sl := slType == "Zone" ? obT : entryPx + atrValue * atrMult
    sl

// =============================================================================
// TAKE PROFIT CALCULATION
// =============================================================================

// For "Swing" TP: use last confirmed opposite pivot
lastSwingHigh = array.size(phPrice) > 0 ? array.get(phPrice, array.size(phPrice) - 1) : float(na)
lastSwingLow  = array.size(plPrice) > 0 ? array.get(plPrice, array.size(plPrice) - 1) : float(na)

// For "Zone" TP: nearest active opposing OB
findNearestOppBullTP(entryPx) =>
    result = float(na)
    size = array.size(obTop)
    if size > 0
        for i = size - 1 to 0
            if array.get(obActive, i) and not array.get(obIsBull, i)
                obB = array.get(obBottom, i)
                if obB > entryPx
                    if na(result) or obB < result
                        result := obB
    result

findNearestOppBearTP(entryPx) =>
    result = float(na)
    size = array.size(obTop)
    if size > 0
        for i = size - 1 to 0
            if array.get(obActive, i) and array.get(obIsBull, i)
                obT = array.get(obTop, i)
                if obT < entryPx
                    if na(result) or obT > result
                        result := obT
    result

calcTP(isLong, entryPx, slPx) =>
    tp = float(na)
    risk = math.abs(entryPx - slPx)
    if isLong
        if tpType == "RR"
            tp := entryPx + risk * rrRatio
        else if tpType == "Swing"
            tp := not na(lastSwingHigh) and lastSwingHigh > entryPx ? lastSwingHigh : entryPx + risk * rrRatio
        else
            zoneTP = findNearestOppBullTP(entryPx)
            tp := not na(zoneTP) ? zoneTP : entryPx + risk * rrRatio
    else
        if tpType == "RR"
            tp := entryPx - risk * rrRatio
        else if tpType == "Swing"
            tp := not na(lastSwingLow) and lastSwingLow < entryPx ? lastSwingLow : entryPx - risk * rrRatio
        else
            zoneTP = findNearestOppBearTP(entryPx)
            tp := not na(zoneTP) ? zoneTP : entryPx - risk * rrRatio
    tp

// =============================================================================
// PERSISTENT TRADE STATE
// =============================================================================

var float entryPrice  = na
var float stopLoss    = na
var float takeProfit  = na
var bool  beTriggered = false
var float trailStop   = na

// =============================================================================
// ENTRIES
// =============================================================================

if longCondition
    entryPrice  := close
    stopLoss    := calcSL(true, bullOBTop, bullOBBottom, close)
    takeProfit  := calcTP(true, close, stopLoss)
    beTriggered := false
    trailStop   := na
    strategy.entry("Long", strategy.long)
    tradesThisDay := tradesThisDay + 1
    lastTradeBar  := bar_index

if shortCondition
    entryPrice  := close
    stopLoss    := calcSL(false, bearOBTop, bearOBBottom, close)
    takeProfit  := calcTP(false, close, stopLoss)
    beTriggered := false
    trailStop   := na
    strategy.entry("Short", strategy.short)
    tradesThisDay := tradesThisDay + 1
    lastTradeBar  := bar_index

// =============================================================================
// BREAK-EVEN & TRAILING (managed manually via strategy.exit updates)
// =============================================================================

if inLong and not na(entryPrice) and not na(stopLoss)
    risk = math.abs(entryPrice - stopLoss)

    // Break-even
    if useBreakEven and not beTriggered and high >= entryPrice + risk * beRR
        stopLoss    := entryPrice
        beTriggered := true

    // Trailing stop update
    if useTrailing
        newTrail = high - atrValue * trailATR
        if na(trailStop)
            trailStop := newTrail
        else
            trailStop := math.max(trailStop, newTrail)
        stopLoss := math.max(stopLoss, trailStop)

    strategy.exit("Long Exit", "Long", stop=stopLoss, limit=takeProfit)

if inShort and not na(entryPrice) and not na(stopLoss)
    risk = math.abs(entryPrice - stopLoss)

    // Break-even
    if useBreakEven and not beTriggered and low <= entryPrice - risk * beRR
        stopLoss    := entryPrice
        beTriggered := true

    // Trailing stop update
    if useTrailing
        newTrail = low + atrValue * trailATR
        if na(trailStop)
            trailStop := newTrail
        else
            trailStop := math.min(trailStop, newTrail)
        stopLoss := math.min(stopLoss, trailStop)

    strategy.exit("Short Exit", "Short", stop=stopLoss, limit=takeProfit)

// =============================================================================
// RESET STATE ON FLAT
// =============================================================================

if strategy.position_size == 0
    entryPrice  := na
    stopLoss    := na
    takeProfit  := na
    beTriggered := false
    trailStop   := na

// =============================================================================
// VISUALS
// =============================================================================

// Plot OB zones (last maxOBs active bullish and bearish)
var box[] bullBoxes = array.new_box()
var box[] bearBoxes = array.new_box()

// Draw active OBs (re-draw each bar for simplicity — extend active ones)
// Bullish OBs (green)
if barstate.islast
    // Clear old boxes
    if array.size(bullBoxes) > 0
        for i = 0 to array.size(bullBoxes) - 1
            box.delete(array.get(bullBoxes, i))
    array.clear(bullBoxes)
    if array.size(bearBoxes) > 0
        for i = 0 to array.size(bearBoxes) - 1
            box.delete(array.get(bearBoxes, i))
    array.clear(bearBoxes)

    bullCount = 0
    bearCount = 0
    size = array.size(obTop)
    if size > 0
        for i = size - 1 to 0
            isAct = array.get(obActive, i)
            isBul = array.get(obIsBull, i)
            obBr  = array.get(obBarIdx, i)
            obT   = array.get(obTop, i)
            obB   = array.get(obBottom, i)
            if isAct and isBul and bullCount < maxOBs
                b = box.new(obBr, obT, bar_index + 5, obB,
                     border_color=color.new(color.green, 30),
                     bgcolor=color.new(color.green, 85),
                     border_width=1)
                array.push(bullBoxes, b)
                bullCount += 1
            if isAct and not isBul and bearCount < maxOBs
                b = box.new(obBr, obT, bar_index + 5, obB,
                     border_color=color.new(color.red, 30),
                     bgcolor=color.new(color.red, 85),
                     border_width=1)
                array.push(bearBoxes, b)
                bearCount += 1

// Trend color
trendColor = bullishTrendLocal ? color.new(color.green, 0) : bearishTrendLocal ? color.new(color.red, 0) : color.new(color.gray, 0)

// BOS labels
plotshape(newBullBOS, style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 20), text="BOS", textcolor=color.white, size=size.tiny)
plotshape(newBearBOS, style=shape.labeldown, location=location.abovebar, color=color.new(color.red,   20), text="BOS", textcolor=color.white, size=size.tiny)

// SL / TP lines (current trade)
plot(strategy.position_size > 0 ? stopLoss   : na, "Long SL",  color=color.red,   style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 ? takeProfit : na, "Long TP",  color=color.green, style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 ? stopLoss   : na, "Short SL", color=color.red,   style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 ? takeProfit : na, "Short TP", color=color.green, style=plot.style_linebr, linewidth=1)

// Entry markers
plotshape(longCondition,  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime,  0), size=size.small, title="Long Entry")
plotshape(shortCondition, style=shape.triangledown, location=location.abovebar, color=color.new(color.red,   0), size=size.small, title="Short Entry")

// Continuation rate table
var table rateTable = table.new(position.top_right, 2, 3, border_width=1)
if barstate.islast
    table.cell(rateTable, 0, 0, "Direction",  text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(rateTable, 1, 0, "Cont. Rate", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(rateTable, 0, 1, "Bull OB",    text_color=color.white, bgcolor=color.new(color.green, 50))
    table.cell(rateTable, 1, 1, str.tostring(bullContRate) + "%", text_color=color.white, bgcolor=bullContRate >= minContinuationRate ? color.new(color.green, 50) : color.new(color.red, 50))
    table.cell(rateTable, 0, 2, "Bear OB",    text_color=color.white, bgcolor=color.new(color.red, 50))
    table.cell(rateTable, 1, 2, str.tostring(bearContRate) + "%", text_color=color.white, bgcolor=bearContRate >= minContinuationRate ? color.new(color.green, 50) : color.new(color.red, 50))
