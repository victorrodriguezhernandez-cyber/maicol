    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.twelvedata.com/time_series?symbol=XAU/USD&interval=1h&outputsize=8&apikey=PON_AQUI_TU_TWELVE_DATA_KEY",
        "options": {}
      },
      "id": "node-velas",
      "name": "Velas 1H del Día",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 420]
    },
    {
      "parameters": {
        "jsCode": "const zona   = $('Leer Zona del Día').first().json;\nconst candles = $('Velas 1H del Día').first().json?.values || [];\n\nif (!zona.tipo_zona || parseFloat(zona.precio_zona_suelo) === 0) throw new Error('Sin zona activa');\n\nconst suelo = parseFloat(zona.precio_zona_suelo);\nconst techo = parseFloat(zona.precio_zona_techo);\nconst es_supply = zona.tipo_zona === 'supply';\n\nlet toco = false, rompio = false, max_rebote = 0;\n\nfor (const v of candles) {\n  const h = parseFloat(v.high), l = parseFloat(v.low);\n  const c = parseFloat(v.close), o = parseFloat(v.open);\n  // ¿Tocó la zona?\n  if (h >= suelo && l <= techo) {\n    toco = true;\n    const rebote = Math.abs(c - o);\n    if (rebote > max_rebote) max_rebote = rebote;\n    // Supply: rompe si cierra por encima del techo con holgura\n    if (es_supply && c > techo * 1.002) rompio = true;\n    // Demand: rompe si cierra por debajo del suelo con holgura\n    if (!es_supply && c < suelo * 0.998) rompio = true;\n  }\n}\n\nlet resultado = 'sin_reaccion';\nif (toco) {\n  if (rompio) resultado = 'rompio';\n  else resultado = max_rebote > (techo - suelo) * 1.5 ? 'respeto_fuerte' : 'respeto_debil';\n}\n\nconst h = new Date().getUTCHours();\nlet sesion = 'new_york';\nif (h >= 22 || h < 8) sesion = 'asia';\nelse if (h >= 8 && h < 13) sesion = 'london';\nelse if (h >= 13 && h < 16) sesion = 'overlap';\n\nconst hoy = new Date().toISOString().split('T')[0];\n\nreturn [{ json: {\n  zona_reg: {\n    fecha: hoy, activo: 'XAUUSD', timeframe: '1H',\n    tipo_zona: zona.tipo_zona,\n    precio_zona_suelo: suelo,\n    precio_zona_techo: techo,\n    direccion_precio: zona.direccion_precio,\n    resultado, sesion\n  },\n  nivel_h_reg: zona.nivel_arriba_precio ? {\n    fecha: hoy, activo: 'XAUUSD', timeframe: '1H',\n    tipo_nivel: 'H',\n    precio: zona.nivel_arriba_precio,\n    fue_roto: resultado === 'rompio' && !es_supply,\n    sesion\n  } : null,\n  nivel_l_reg: zona.nivel_abajo_precio ? {\n    fecha: hoy, activo: 'XAUUSD', timeframe: '1H',\n    tipo_nivel: 'L',\n    precio: zona.nivel_abajo_precio,\n    fue_roto: resultado === 'rompio' && es_supply,\n    sesion\n  } : null\n}}];"
      },
