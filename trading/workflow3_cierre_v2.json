      "id": "node-velas",
      "name": "Velas 1H del Día",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 420]
    },
    {
      "parameters": {
        "jsCode": "const analisis = $('Leer Zona del Día').first().json;\nconst priceData = $('Velas 1H del Día').first().json;\n\nif (!analisis.tipo_zona || parseFloat(analisis.precio_zona_suelo) === 0) {\n  throw new Error('No hay zona activa hoy');\n}\n\nconst suelo = parseFloat(analisis.precio_zona_suelo);\nconst techo = parseFloat(analisis.precio_zona_techo);\nconst values = priceData?.values || [];\n\nlet toco = false, rompio = false;\nlet max_rebote = 0;\n\nfor (const v of values) {\n  const h = parseFloat(v.high), l = parseFloat(v.low), c = parseFloat(v.close), o = parseFloat(v.open);\n  if (h >= suelo && l <= techo) {\n    toco = true;\n    const rebote = Math.abs(c - o);\n    if (rebote > max_rebote) max_rebote = rebote;\n    if (analisis.direccion_precio === 'alcista' && c > techo * 1.002) rompio = true;\n    if (analisis.direccion_precio === 'bajista' && c < suelo * 0.998) rompio = true;\n  }\n}\n\nlet resultado = 'sin_reaccion';\nif (toco) {\n  if (rompio) resultado = 'rompio';\n  else resultado = max_rebote > (techo - suelo) * 1.5 ? 'respeto_fuerte' : 'respeto_debil';\n}\n\nconst h = new Date().getUTCHours();\nlet sesion = 'new_york';\nif (h >= 22 || h < 8) sesion = 'asia';\nelse if (h >= 8 && h < 13) sesion = 'london';\nelse if (h >= 13 && h < 16) sesion = 'overlap';\n\nconst hoy = new Date().toISOString().split('T')[0];\n\nreturn [{ json: {\n  registro: {\n    fecha: hoy, activo: 'XAUUSD', timeframe: '1H',\n    tipo_zona: analisis.tipo_zona,\n    precio_zona_suelo: suelo, precio_zona_techo: techo,\n    direccion_precio: analisis.direccion_precio,\n    resultado, sesion\n  }\n}}];"
      },
