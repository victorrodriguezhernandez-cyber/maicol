      "position": [420, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.twelvedata.com/price?symbol=XAU/USD&apikey=PON_AQUI_TU_TWELVE_DATA_KEY",
        "options": {}
      },
      "id": "node-precio",
      "name": "Precio Actual XAU/USD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 420]
    },
    {
      "parameters": {
        "jsCode": "const analisis = $('Leer Zona Activa').first().json;\nconst priceResp = $('Precio Actual XAU/USD').first().json;\nconst precio_actual = parseFloat(priceResp.price);\n\nif (!precio_actual || !analisis.tipo_zona) {\n  throw new Error('Sin datos para recalcular');\n}\n\nconst suelo = parseFloat(analisis.precio_zona_suelo);\nconst techo = parseFloat(analisis.precio_zona_techo);\nconst mid = (suelo + techo) / 2;\nconst dist_pct = Math.abs(precio_actual - mid) / mid * 100;\n\nlet fase = 'LEJOS';\nif (precio_actual >= suelo && precio_actual <= techo) fase = 'EN_ZONA';\nelse if (dist_pct < 0.3) fase = 'ACERCANDO';\n\nreturn [{ json: { fase, updated_at: new Date().toISOString() } }];"
      },
      "id": "node-recalc",
      "name": "Recalcular Fase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://pyiukqeuaxonsrrgbfzq.supabase.co/rest/v1/analisis_actual?id=eq.1",
        "sendHeaders": true,
