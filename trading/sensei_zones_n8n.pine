//@version=6
indicator("SENSEI VISUAL ZONES v0.6.1 + n8n Stats", overlay=true, max_boxes_count=20, max_lines_count=30, max_labels_count=30)

// ══════════════════════════════════════════════════════
//  AJUSTES ORIGINALES
// ══════════════════════════════════════════════════════
pivotLen        = input.int(5,    "Sensibilidad pivotes",            minval=2,  maxval=20)
levelLookback   = input.int(80,   "Buscar niveles en ultimas velas", minval=20, maxval=300)
extendBars      = input.int(90,   "Extension lineas/zonas",          minval=20, maxval=300)
labelOffset     = input.int(18,   "Distancia etiquetas",             minval=5,  maxval=80)

minGapATR       = input.float(0.10, "Separacion minima precio ATR", minval=0.00, step=0.05)
maxDistATR      = input.float(5.00, "Distancia maxima nivel ATR",   minval=1.00, step=0.25)

zoneLookback    = input.int(50,  "Buscar zonas en ultimas velas", minval=15, maxval=150)
zoneBars        = input.int(5,   "Velas base zona",               minval=3,  maxval=15)
maxZoneATR      = input.float(1.20, "Altura maxima zona ATR",     minval=0.30, step=0.10)
minMoveATR      = input.float(1.00, "Movimiento minimo tras zona ATR", minval=0.30, step=0.10)

showLevels      = input.bool(true,  "Mostrar niveles H/L")
showZones       = input.bool(true,  "Mostrar zonas grises")
showLabels      = input.bool(true,  "Mostrar etiquetas")
showBOS         = input.bool(false, "Mostrar BOS")
hideInvalidated = input.bool(true,  "Ocultar zonas invalidadas")

// ══════════════════════════════════════════════════════
//  AJUSTES n8n / ESTADÍSTICAS
// ══════════════════════════════════════════════════════
var string GRP = "Estadisticas n8n (actualizar tras ejecucion)"
bool   showPanel   = input.bool(true,  "Mostrar panel estadisticas",  group=GRP)
float  n_sz_resp_f = input.float(0,    "Supply: % Respeto fuerte",    group=GRP)
float  n_sz_resp_d = input.float(0,    "Supply: % Respeto debil",     group=GRP)
float  n_sz_rompio = input.float(0,    "Supply: % Rompio",            group=GRP)
int    n_sz_casos  = input.int(0,      "Supply: Casos totales",       group=GRP)
float  n_dz_resp_f = input.float(0,    "Demand: % Respeto fuerte",    group=GRP)
float  n_dz_resp_d = input.float(0,    "Demand: % Respeto debil",     group=GRP)
float  n_dz_rompio = input.float(0,    "Demand: % Rompio",            group=GRP)
int    n_dz_casos  = input.int(0,      "Demand: Casos totales",       group=GRP)
float  n_h_ruptura = input.float(0,    "Nivel H: % Ruptura",          group=GRP)
float  n_l_soporte = input.float(0,    "Nivel L: % Soporte",          group=GRP)
float  n_score     = input.float(0,    "Score confluencia",            group=GRP)
string n_fase      = input.string("LEJOS", "Fase", group=GRP, options=["LEJOS","ACERCANDO","EN_ZONA"])

// ══════════════════════════════════════════════════════
//  COLORES
// ══════════════════════════════════════════════════════
zoneBg      = color.new(color.gray, 80)
zoneBorder  = color.new(color.gray, 25)
resColor    = color.new(color.red, 35)
supColor    = color.new(color.green, 35)
resTagColor = color.new(color.red, 10)
supTagColor = color.new(color.green, 10)
bosRed      = color.new(color.red, 65)
bosGreen    = color.new(color.green, 65)

// ══════════════════════════════════════════════════════
//  BASE
// ══════════════════════════════════════════════════════
atr = ta.atr(14)
ph  = ta.pivothigh(high, pivotLen, pivotLen)
pl  = ta.pivotlow(low,  pivotLen, pivotLen)

var float[] highs    = array.new_float()
var int[]   highBars = array.new_int()
var float[] lows     = array.new_float()
var int[]   lowBars  = array.new_int()

if not na(ph)
    array.push(highs, ph)
    array.push(highBars, bar_index - pivotLen)
    if array.size(highs) > 60
        array.shift(highs)
        array.shift(highBars)

if not na(pl)
    array.push(lows, pl)
    array.push(lowBars, bar_index - pivotLen)
    if array.size(lows) > 60
        array.shift(lows)
        array.shift(lowBars)

// ══════════════════════════════════════════════════════
//  RESISTENCIA MÁS CERCANA
// ══════════════════════════════════════════════════════
float nearestHigh    = na
int   nearestHighBar = na
float bestHighDist   = 100000000.0

if array.size(highs) > 0
    for i = 0 to array.size(highs) - 1
        h    = array.get(highs, i)
        hb   = array.get(highBars, i)
        age  = bar_index - hb
        dist = h - close
        valid = age <= levelLookback and h > close + atr * minGapATR and dist <= atr * maxDistATR
        if valid and dist < bestHighDist
            nearestHigh    := h
            nearestHighBar := hb
            bestHighDist   := dist

// ══════════════════════════════════════════════════════
//  SOPORTE MÁS CERCANO
// ══════════════════════════════════════════════════════
float nearestLow    = na
int   nearestLowBar = na
float bestLowDist   = 100000000.0

if array.size(lows) > 0
    for i = 0 to array.size(lows) - 1
        l    = array.get(lows, i)
        lb   = array.get(lowBars, i)
        age  = bar_index - lb
        dist = close - l
        valid = age <= levelLookback and l < close - atr * minGapATR and dist <= atr * maxDistATR
        if valid and dist < bestLowDist
            nearestLow    := l
            nearestLowBar := lb
            bestLowDist   := dist

// ══════════════════════════════════════════════════════
//  OBJETOS
// ══════════════════════════════════════════════════════
var line  highLine   = na
var line  lowLine    = na
var label highLabel  = na
var label lowLabel   = na
var box   supplyZone = na
var box   demandZone = na
var line  bosLine    = na
var label bosLabel   = na

// ══════════════════════════════════════════════════════
//  NIVEL SUPERIOR
// ══════════════════════════════════════════════════════
if showLevels and not na(nearestHigh)
    if na(highLine)
        highLine := line.new(nearestHighBar, nearestHigh, bar_index + extendBars, nearestHigh, xloc=xloc.bar_index, extend=extend.none, color=resColor, style=line.style_dotted, width=1)
    else
        line.set_xy1(highLine, nearestHighBar, nearestHigh)
        line.set_xy2(highLine, bar_index + extendBars, nearestHigh)

    if showLabels
        if na(highLabel)
            highLabel := label.new(bar_index + labelOffset, nearestHigh, "H", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=resTagColor, size=size.tiny)
        else
            label.set_x(highLabel, bar_index + labelOffset)
            label.set_y(highLabel, nearestHigh)
            label.set_text(highLabel, "H")
            label.set_color(highLabel, resTagColor)

// ══════════════════════════════════════════════════════
//  NIVEL INFERIOR
// ══════════════════════════════════════════════════════
if showLevels and not na(nearestLow)
    if na(lowLine)
        lowLine := line.new(nearestLowBar, nearestLow, bar_index + extendBars, nearestLow, xloc=xloc.bar_index, extend=extend.none, color=supColor, style=line.style_dotted, width=1)
    else
        line.set_xy1(lowLine, nearestLowBar, nearestLow)
        line.set_xy2(lowLine, bar_index + extendBars, nearestLow)

    if showLabels
        if na(lowLabel)
            lowLabel := label.new(bar_index + labelOffset, nearestLow, "L", xloc=xloc.bar_index, style=label.style_label_left, textcolor=color.white, color=supTagColor, size=size.tiny)
        else
            label.set_x(lowLabel, bar_index + labelOffset)
            label.set_y(lowLabel, nearestLow)
            label.set_text(lowLabel, "L")
            label.set_color(lowLabel, supTagColor)

// ══════════════════════════════════════════════════════
//  ZONA DE VENTA (SUPPLY)
// ══════════════════════════════════════════════════════
float sTop  = na
float sBot  = na
int   sLeft = na

for i = zoneBars to zoneLookback
    bHigh = high[i]
    bLow  = low[i]
    for j = 0 to zoneBars - 1
        bHigh := math.max(bHigh, high[i - j])
        bLow  := math.min(bLow,  low[i - j])
    height     = bHigh - bLow
    moveDown   = bLow - low
    compact    = height   <= atr * maxZoneATR
    impulse    = moveDown >= atr * minMoveATR
    priceBelow = close < bLow
    if na(sLeft) and compact and impulse and priceBelow
        sTop  := bHigh
        sBot  := bLow
        sLeft := bar_index - i

// ══════════════════════════════════════════════════════
//  ZONA DE COMPRA (DEMAND)
// ══════════════════════════════════════════════════════
float dTop  = na
float dBot  = na
int   dLeft = na

for i = zoneBars to zoneLookback
    bHigh = high[i]
    bLow  = low[i]
    for j = 0 to zoneBars - 1
        bHigh := math.max(bHigh, high[i - j])
        bLow  := math.min(bLow,  low[i - j])
    height     = bHigh - bLow
    moveUp     = high - bHigh
    compact    = height <= atr * maxZoneATR
    impulse    = moveUp >= atr * minMoveATR
    priceAbove = close > bHigh
    if na(dLeft) and compact and impulse and priceAbove
        dTop  := bHigh
        dBot  := bLow
        dLeft := bar_index - i

// ══════════════════════════════════════════════════════
//  PINTAR ZONA DE VENTA
// ══════════════════════════════════════════════════════
if showZones and not na(sLeft)
    if na(supplyZone)
        supplyZone := box.new(sLeft, sTop, bar_index + extendBars, sBot, xloc=xloc.bar_index, bgcolor=zoneBg, border_color=zoneBorder)
    else
        box.set_left(supplyZone, sLeft)
        box.set_top(supplyZone, sTop)
        box.set_bottom(supplyZone, sBot)
        box.set_right(supplyZone, bar_index + extendBars)

// ══════════════════════════════════════════════════════
//  PINTAR ZONA DE COMPRA
// ══════════════════════════════════════════════════════
if showZones and not na(dLeft)
    if na(demandZone)
        demandZone := box.new(dLeft, dTop, bar_index + extendBars, dBot, xloc=xloc.bar_index, bgcolor=zoneBg, border_color=zoneBorder)
    else
        box.set_left(demandZone, dLeft)
        box.set_top(demandZone, dTop)
        box.set_bottom(demandZone, dBot)
        box.set_right(demandZone, bar_index + extendBars)

// ══════════════════════════════════════════════════════
//  INVALIDAR ZONAS
// ══════════════════════════════════════════════════════
if hideInvalidated and not na(supplyZone)
    if close > box.get_top(supplyZone) + atr * 0.10
        box.delete(supplyZone)
        supplyZone := na

if hideInvalidated and not na(demandZone)
    if close < box.get_bottom(demandZone) - atr * 0.10
        box.delete(demandZone)
        demandZone := na

// ══════════════════════════════════════════════════════
//  BOS OPCIONAL
// ══════════════════════════════════════════════════════
bosUp = showBOS and not na(nearestHigh) and close > nearestHigh + atr * 0.10
bosDn = showBOS and not na(nearestLow)  and close < nearestLow  - atr * 0.10

if bosUp
    if not na(bosLine)
        line.delete(bosLine)
    if not na(bosLabel)
        label.delete(bosLabel)
    bosLine  := line.new(bar_index - 3, nearestHigh, bar_index, nearestHigh, xloc=xloc.bar_index, color=bosGreen, style=line.style_solid, width=1)
    bosLabel := label.new(bar_index, nearestHigh, "BOS", xloc=xloc.bar_index, style=label.style_label_up, textcolor=color.white, color=bosGreen, size=size.tiny)

if bosDn
    if not na(bosLine)
        line.delete(bosLine)
    if not na(bosLabel)
        label.delete(bosLabel)
    bosLine  := line.new(bar_index - 3, nearestLow, bar_index, nearestLow, xloc=xloc.bar_index, color=bosRed, style=line.style_solid, width=1)
    bosLabel := label.new(bar_index, nearestLow, "BOS", xloc=xloc.bar_index, style=label.style_label_down, textcolor=color.white, color=bosRed, size=size.tiny)

// ══════════════════════════════════════════════════════
//  WEBHOOK PAYLOAD → n8n
// ══════════════════════════════════════════════════════
bool es_laborable = dayofweek >= 2 and dayofweek <= 6
bool en_sesion    = hour >= 14 and hour < 21
bool cada_30min   = minute == 0 or minute == 30
bool hay_zona     = not na(sTop) or not na(dTop)
bool disparar     = es_laborable and en_sesion and cada_30min and hay_zona

string p_sz_top = na(sTop)        ? "null" : str.tostring(sTop,        "#.##")
string p_sz_bot = na(sBot)        ? "null" : str.tostring(sBot,        "#.##")
string p_dz_top = na(dTop)        ? "null" : str.tostring(dTop,        "#.##")
string p_dz_bot = na(dBot)        ? "null" : str.tostring(dBot,        "#.##")
string p_h      = na(nearestHigh) ? "null" : str.tostring(nearestHigh, "#.##")
string p_l      = na(nearestLow)  ? "null" : str.tostring(nearestLow,  "#.##")
string p_close  = str.tostring(close, "#.##")
string p_atr    = str.tostring(atr,   "#.####")

string payload = '{"activo":"XAUUSD","precio_actual":' + p_close + ',"atr":' + p_atr + ',"supply_zone_top":' + p_sz_top + ',"supply_zone_bot":' + p_sz_bot + ',"demand_zone_top":' + p_dz_top + ',"demand_zone_bot":' + p_dz_bot + ',"nivel_h":' + p_h + ',"nivel_l":' + p_l + '}'

alertcondition(disparar, title="Sensei n8n XAU/USD", message="{payload}")

// ══════════════════════════════════════════════════════
//  PANEL ESTADÍSTICAS n8n
// ══════════════════════════════════════════════════════
if showPanel and barstate.islast
    string fase_dot = n_fase == "EN_ZONA" ? "● " : n_fase == "ACERCANDO" ? "◑ " : "○ "

    string sz_txt = not na(sTop) ? "\n── SUPPLY  " + str.tostring(sBot, "#.##") + " - " + str.tostring(sTop, "#.##") + (n_sz_casos > 0 ? "\n   R.Fuerte " + str.tostring(n_sz_resp_f, "#.#") + "%  R.Debil " + str.tostring(n_sz_resp_d, "#.#") + "%  Rompio " + str.tostring(n_sz_rompio, "#.#") + "% [" + str.tostring(n_sz_casos) + "]" + (n_sz_casos < 15 ? "\n   ! muestra insuficiente" : "") : "\n   Sin historial aun") : ""

    string dz_txt = not na(dTop) ? "\n── DEMAND  " + str.tostring(dBot, "#.##") + " - " + str.tostring(dTop, "#.##") + (n_dz_casos > 0 ? "\n   R.Fuerte " + str.tostring(n_dz_resp_f, "#.#") + "%  R.Debil " + str.tostring(n_dz_resp_d, "#.#") + "%  Rompio " + str.tostring(n_dz_rompio, "#.#") + "% [" + str.tostring(n_dz_casos) + "]" + (n_dz_casos < 15 ? "\n   ! muestra insuficiente" : "") : "\n   Sin historial aun") : ""

    string h_txt = not na(nearestHigh) ? "\n── H  " + str.tostring(nearestHigh, "#.##") + (n_h_ruptura > 0 ? "   ruptura " + str.tostring(n_h_ruptura, "#.#") + "%" : "") : ""
    string l_txt = not na(nearestLow)  ? "\n── L  " + str.tostring(nearestLow,  "#.##") + (n_l_soporte > 0 ? "   soporte " + str.tostring(n_l_soporte, "#.#") + "%" : "") : ""
    string score_txt = n_score > 0 ? "\nScore " + str.tostring(n_score, "#.#") + "/100" : ""

    string txt = "SENSEI ZONES\n" + fase_dot + n_fase + sz_txt + dz_txt + h_txt + l_txt + score_txt

    var table pnl = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 15), border_color=color.new(color.gray, 40), border_width=1)
    table.cell(pnl, 0, 0, text=txt, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 25))
