      "id": "node-precio",
      "name": "Precio Actual",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 400]
    },
    {
      "parameters": {
        "jsCode": "const zona = $('Leer Zona Activa').first().json;\nconst precio_actual = parseFloat($('Precio Actual').first().json.price);\n\nif (!precio_actual || !zona.tipo_zona) throw new Error('Sin datos');\n\nconst suelo = parseFloat(zona.precio_zona_suelo);\nconst techo = parseFloat(zona.precio_zona_techo);\n\nlet fase = 'LEJOS';\nif (precio_actual >= suelo && precio_actual <= techo) {\n  fase = 'EN_ZONA';\n} else {\n  const dist = zona.tipo_zona === 'supply'\n    ? Math.abs(precio_actual - suelo) / precio_actual * 100\n    : Math.abs(precio_actual - techo) / precio_actual * 100;\n  if (dist < 0.3) fase = 'ACERCANDO';\n}\n\nreturn [{ json: { fase, updated_at: new Date().toISOString() } }];"
      },
      "id": "node-fase",
      "name": "Recalcular Fase",
      "type": "n8n-nodes-base.code",
