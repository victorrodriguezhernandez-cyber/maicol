# =============================================================================
# Maicol Nutrition — environment variables
# Copy this file to .env.local for local development. Never commit real
# secrets — .env* (except this file) is gitignored.
# =============================================================================

# --- Supabase -----------------------------------------------------------
# Project URL and publishable (anon) key: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key: SERVER-SIDE ONLY. Bypasses Row Level Security.
# Used only in Next.js Route Handlers / Server Actions and Supabase Edge
# Functions that must write shared/global catalog rows. Never import this
# in any file that ships to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gemini (AI capture + coach) ----------------------------------------
# Server-side only — used from Route Handlers and Edge Functions.
GEMINI_API_KEY=your-gemini-api-key
# Keep the concrete model name out of application code. Pick any current
# multimodal Flash model available on your account/tier.
GEMINI_MODEL=gemini-2.5-flash

# --- USDA FoodData Central ------------------------------------------------
# https://fdc.nal.usda.gov/api-key-signup.html (DEMO_KEY works for light use)
USDA_API_KEY=your-usda-api-key

# --- Open Food Facts -------------------------------------------------------
# No key required; public API. Set a descriptive User-Agent per their
# usage policy.
OPEN_FOOD_FACTS_USER_AGENT=MaicolNutrition/1.0 (contact: you@example.com)
