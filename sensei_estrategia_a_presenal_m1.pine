//@version=6
indicator("SENSEI - Estrategia A + PRESEÑAL M1", overlay=true,
     max_lines_count=200, max_labels_count=500, max_boxes_count=200)

// ============================================================================
// Estrategia A (réplica de backtest_A) + una capa de PRE-SEÑAL intrabar.
//
// La capa de pre-señal NO toca pendLimite / entrada / stop / objetivo /
// nSenalesHoy / historialR. Solo lee. El motor y sus resultados son idénticos
// a sensei_estrategia_a.pine.
// ============================================================================

// --- Activo y parámetros ---
activo = input.string("XAUUSD", "Activo",
     options=["XAUUSD","USDJPY_i","AUDUSD_i","EURJPY_i","USDCAD_i","EURUSD_i","BTCUSD"], group="Activo")
retK   = input.float(0.7, "Retroceso de entrada (x ATR)", group="Parámetros del backtest (no tocar)")
val    = input.int(5, "Velas de validez de la orden límite", group="Parámetros del backtest (no tocar)")
maxdia = input.int(1, "Operaciones máx. por día", group="Parámetros del backtest (no tocar)")

// --- Pre-señal intrabar ---
activarPreSenal     = input.bool(true, "Activar PRE-SEÑAL intrabar", group="PRE-SEÑAL")
minutoMinimo        = input.int(1, "Empezar a comprobar desde el minuto", minval=1, maxval=29, group="PRE-SEÑAL")
avisarActualizacion = input.bool(false, "Avisar cada vez que cambie el límite provisional", group="PRE-SEÑAL")

// stop por activo (SL_A) y coste de spread en R (COSTE) — igual que el Python
slK = switch activo
    "XAUUSD"   => 1.5
    "BTCUSD"   => 2.5
    => 1.0

costeR = switch activo
    "XAUUSD"   => 0.005
    "USDJPY_i" => 0.009
    "AUDUSD_i" => 0.037
    "EURJPY_i" => 0.041
    "USDCAD_i" => 0.048
    "EURUSD_i" => 0.000
    "BTCUSD"   => 0.050
    => 0.0

// timeframe de señal por activo (TF_A) — EURUSD va en 30m, el resto en 15m
tfEsperado = activo == "EURUSD_i" ? "30" : "15"
// el aviso solo en la última vela: si no, pinta una etiqueta por vela y agota
// max_labels_count, borrando las etiquetas reales de señal/entrada/salida
if timeframe.period != tfEsperado and barstate.islast
    label.new(bar_index, high, "⚠ " + activo + " requiere gráfico de " + tfEsperado +
         "m — estás en " + timeframe.period + "m. Los resultados NO serán fiables.",
         style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

h1v = 10 * 60   // 10:00 Madrid
h2v = 21 * 60   // 21:00 Madrid

// ============================================================================
// 1. TENDENCIA: EMA200 del H1, usando SIEMPRE la vela H1 ya cerrada
// ============================================================================
f_tend_h1() =>
    e = ta.ema(close, 200)
    close > e ? 1 : -1

tend = request.security(syminfo.tickerid, "60", f_tend_h1()[1], lookahead=barmerge.lookahead_off)

ema200_h1_plot = request.security(syminfo.tickerid, "60", ta.ema(close, 200)[1], lookahead=barmerge.lookahead_off)
plot(ema200_h1_plot, "EMA200 H1 (diagnóstico)", color=color.orange, linewidth=2)
bgcolor(tend == 1 ? color.new(color.green, 92) : tend == -1 ? color.new(color.red, 92) : na)

// ============================================================================
// 2. ATR14 Wilder
// ============================================================================
atr = ta.atr(14)

// ============================================================================
// 3. VENTANA HORARIA + 1 SEÑAL/DÍA MÁXIMO
// ============================================================================
minsDia   = hour(time, "Europe/Madrid") * 60 + minute(time, "Europe/Madrid")
enVentana = minsDia >= h1v and minsDia < h2v

var int nSenalesHoy = 0
if ta.change(dayofmonth(time, "Europe/Madrid")) != 0
    nSenalesHoy := 0

esSenal = tend != 0 and not na(atr) and atr > 0 and enVentana and
     nSenalesHoy < maxdia and (close - open) * tend > 0

// ============================================================================
// 4. ESTADO PERSISTENTE DE LA OPERACIÓN
// ============================================================================
var float pendLimite  = na
var int   pendDir     = na
var int   pendRestan  = na

var bool  enPosicion = false
var float entrada = na
var float stop    = na
var float objetivo = na
var int   dirOp   = na

var float ultimoR = na
var string ultimoResultado = na
var float[] historialR = array.new_float(0)

var line lEntrada = na
var line lStop = na
var line lObjetivo = na

// ============================================================================
// 4-PRE. PRE-SEÑAL INTRABAR (solo en tiempo real)
//
// En la vela en formación, Pine YA da los valores provisionales que hacen
// falta, sin reconstruir nada desde M1:
//     close      = último precio negociado
//     high / low = extremos parciales de la vela en curso
//     ta.atr(14) = ATR Wilder con el TR parcial de la vela en curso
//                  ( (ATR[1]*13 + TR_parcial) / 14 )
// Por eso el límite provisional se calcula con la MISMA fórmula del motor
// (close - tend * retK * atr) y converge exactamente al límite definitivo
// en el último tick de la vela.
//
// Solo se ejecuta en barstate.isrealtime: en histórico close/high/low ya son
// definitivos, así que una "pre-señal" ahí sería idéntica a la señal confirmada
// y solo serviría para gastar etiquetas.
// ============================================================================

// minutos que dura una vela del gráfico (15 o 30)
minsPorVela = int(timeframe.in_seconds(timeframe.period) / 60)

// varip sobrevive a los recálculos de la vela en curso (var haría rollback en
// cada tick y la pre-señal se re-anunciaría una y otra vez)
varip int   preBar         = na
varip bool  preAvisada     = false
varip bool  preValidaAhora = false
varip float preLimiteAct   = na
varip float preLimiteAvis  = na
varip int   preDir         = na
varip int   preMinutoDet   = na

// vela nueva -> se reinicia solo la capa provisional
if na(preBar) or preBar != bar_index
    preBar         := bar_index
    preAvisada     := false
    preValidaAhora := false
    preLimiteAct   := na
    preLimiteAvis  := na
    preDir         := na
    preMinutoDet   := na

// minuto en curso dentro de la vela, 1..minsPorVela
minutoEnCurso = int(math.min(minsPorVela, math.floor((timenow - time) / 60000) + 1))

// misma condición direccional del motor, con el close disponible ahora mismo
condicionPre = activarPreSenal and barstate.isrealtime and
     minutoEnCurso >= minutoMinimo and
     tend != 0 and not na(atr) and atr > 0 and enVentana and
     nSenalesHoy < maxdia and not enPosicion and na(pendLimite) and
     (close - open) * tend > 0

preValidaAhora := condicionPre

if condicionPre
    preLimiteAct := close - tend * retK * atr
    preDir       := tend
    if not preAvisada
        preAvisada    := true
        preMinutoDet  := minutoEnCurso
        preLimiteAvis := preLimiteAct
        alert(activo + " PRE-SEÑAL " + (preDir == 1 ? "LONG" : "SHORT") +
             " | Minuto " + str.tostring(minutoEnCurso) + "/" + str.tostring(minsPorVela) +
             " | Entrada provisional " + str.tostring(preLimiteAct, format.mintick) +
             " | NO CONFIRMADA hasta el cierre de la vela", alert.freq_all)
    else if avisarActualizacion and preLimiteAct != preLimiteAvis
        preLimiteAvis := preLimiteAct
        alert(activo + " PRE-SEÑAL actualiza límite " + (preDir == 1 ? "LONG" : "SHORT") +
             " | Minuto " + str.tostring(minutoEnCurso) + "/" + str.tostring(minsPorVela) +
             " | Nuevo límite provisional " + str.tostring(preLimiteAct, format.mintick), alert.freq_all)

// La etiqueta se redibuja en cada tick a propósito: en la vela en tiempo real
// Pine borra los dibujos del tick anterior, así que redibujar es lo que hace
// que se vea una sola etiqueta y con el precio provisional actualizado.
if preAvisada and barstate.isrealtime
    label.new(bar_index, preDir == 1 ? low : high,
         "⚡ PRE-SEÑAL " + (preDir == 1 ? "▲ LONG" : "▼ SHORT") +
         "\nMinuto " + str.tostring(minutoEnCurso) + "/" + str.tostring(minsPorVela) +
         (preValidaAhora ? "" : "  (ya no se cumple)") +
         "\nEntrada prov.: " + str.tostring(preLimiteAct, format.mintick),
         style = preDir == 1 ? label.style_label_up : label.style_label_down,
         color = preValidaAhora ? color.orange : color.new(color.orange, 55),
         textcolor = color.white, size = size.normal)

// -- 4a. Nueva señal -> crea orden límite pendiente --
if esSenal and na(pendLimite) and not enPosicion and barstate.isconfirmed
    pendLimite := close - tend * retK * atr
    pendDir    := tend
    pendRestan := val
    label.new(bar_index, pendDir == 1 ? low : high,
         "SEÑAL " + (pendDir == 1 ? "▲ LONG" : "▼ SHORT") +
         "\nENTRADA LÍMITE: " + str.tostring(pendLimite, format.mintick),
         style = pendDir == 1 ? label.style_label_up : label.style_label_down,
         color = color.gray, textcolor = color.white, size = size.small)
    alert(activo + " SEÑAL CONFIRMADA " + (pendDir == 1 ? "LONG" : "SHORT") +
         " | Entrada límite " + str.tostring(pendLimite, format.mintick),
         alert.freq_once_per_bar_close)

// -- 4b. Orden pendiente: comprobar relleno con precisión M1 --
if not na(pendLimite) and not enPosicion
    [lo1, hi1] = request.security_lower_tf(syminfo.tickerid, "1", [low, high])
    filled = false
    if array.size(lo1) > 0
        for i = 0 to array.size(lo1) - 1
            if not filled
                l1 = array.get(lo1, i)
                h1 = array.get(hi1, i)
                if (pendDir == 1 and l1 <= pendLimite) or (pendDir == -1 and h1 >= pendLimite)
                    filled := true
    if filled
        entrada := pendLimite
        dirOp   := pendDir
        nSenalesHoy += 1
        riesgo  = slK * atr
        stop     := entrada - dirOp * riesgo
        objetivo := entrada + dirOp * riesgo * 1.0   // RR 1:1
        enPosicion := true
        pendLimite := na
        pendDir    := na
        lEntrada  := line.new(bar_index, entrada, bar_index + 1, entrada, extend=extend.right, color=color.blue,  style=line.style_dashed)
        lStop     := line.new(bar_index, stop,    bar_index + 1, stop,    extend=extend.right, color=color.red,   style=line.style_dashed)
        lObjetivo := line.new(bar_index, objetivo,bar_index + 1, objetivo,extend=extend.right, color=color.green, style=line.style_dashed)
        label.new(bar_index, entrada,
             "ENTRADA " + (dirOp == 1 ? "LONG" : "SHORT") +
             "\nEntrada: " + str.tostring(entrada, format.mintick) +
             "\nSL: " + str.tostring(stop, format.mintick) +
             "\nTP: " + str.tostring(objetivo, format.mintick),
             style = dirOp == 1 ? label.style_label_up : label.style_label_down,
             color = color.blue, textcolor = color.white)
        alert(activo + " ENTRADA " + (dirOp == 1 ? "LONG" : "SHORT") +
             " @ " + str.tostring(entrada, format.mintick) +
             " | SL " + str.tostring(stop, format.mintick) +
             " | TP " + str.tostring(objetivo, format.mintick),
             alert.freq_once_per_bar)
    else
        pendRestan -= 1
        if pendRestan <= 0
            pendLimite := na
            pendDir    := na

// -- 4c. Posición abierta: resolver SL/TP con precisión M1 (empate -> gana el stop) --
if enPosicion
    [lo1b, hi1b] = request.security_lower_tf(syminfo.tickerid, "1", [low, high])
    cerrada = false
    float resR = na
    if array.size(lo1b) > 0
        for i = 0 to array.size(lo1b) - 1
            if not cerrada
                l1 = array.get(lo1b, i)
                h1 = array.get(hi1b, i)
                hitSL = dirOp == 1 ? l1 <= stop : h1 >= stop
                hitTP = dirOp == 1 ? h1 >= objetivo : l1 <= objetivo
                if hitSL
                    resR := -1.0 - costeR
                    cerrada := true
                else if hitTP
                    resR := 1.0 - costeR
                    cerrada := true
    if cerrada
        ultimoR := resR
        ultimoResultado := resR > 0 ? "GANADA" : "PERDIDA"
        label.new(bar_index, resR > 0 ? high : low,
             ultimoResultado + " " + str.tostring(resR, "#.####") + "R",
             style = resR > 0 ? label.style_label_down : label.style_label_up,
             color = resR > 0 ? color.green : color.red, textcolor = color.white)
        alert(activo + " SALIDA " + ultimoResultado + " " + str.tostring(resR, "#.####") + "R",
             alert.freq_once_per_bar)
        line.set_extend(lEntrada, extend.none)
        line.set_x2(lEntrada, bar_index)
        line.set_extend(lStop, extend.none)
        line.set_x2(lStop, bar_index)
        line.set_extend(lObjetivo, extend.none)
        line.set_x2(lObjetivo, bar_index)
        array.push(historialR, resR)
        enPosicion := false
        entrada := na
        stop := na
        objetivo := na
        dirOp := na

// ============================================================================
// 5. ESTADÍSTICAS ACUMULADAS
// ============================================================================
nOps = array.size(historialR)
var float winrate = na
var float rProm = na
var float rTotal = na
var int rachaGanActual = 0
var int rachaPerdActual = 0
var int rachaGanMax = 0
var int rachaPerdMax = 0
var float ddMax = 0.0
var string ultimos5 = "-"

if barstate.islast and nOps > 0
    wins = 0
    cGan = 0
    cPerd = 0
    cum = 0.0
    cumMax = 0.0
    rgMax = 0
    rpMax = 0
    for i = 0 to nOps - 1
        r = array.get(historialR, i)
        if r > 0
            wins += 1
            cGan += 1
            rgMax := math.max(rgMax, cGan)
            cPerd := 0
        else
            cPerd += 1
            rpMax := math.max(rpMax, cPerd)
            cGan := 0
        cum += r
        cumMax := math.max(cumMax, cum)
        ddMax := math.max(ddMax, cumMax - cum)
    rachaGanMax := rgMax
    rachaPerdMax := rpMax
    rachaGanActual := 0
    rachaPerdActual := 0
    if array.get(historialR, nOps - 1) > 0
        i2 = nOps - 1
        while i2 >= 0 and array.get(historialR, i2) > 0
            rachaGanActual += 1
            i2 -= 1
    else
        i2 = nOps - 1
        while i2 >= 0 and array.get(historialR, i2) <= 0
            rachaPerdActual += 1
            i2 -= 1
    winrate := wins / nOps * 100.0
    rTotal := array.sum(historialR)
    rProm := rTotal / nOps
    ultimos5 := ""
    for i = math.max(0, nOps - 5) to nOps - 1
        ultimos5 := ultimos5 + (array.get(historialR, i) > 0 ? "✅" : "❌")

breakeven = 50.0

// ============================================================================
// 6. PANEL EN PANTALLA
// ============================================================================
var table t = table.new(position.top_right, 2, 15, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "Activo (Estrategia A)", text_color = color.white, bgcolor = color.gray)
    table.cell(t, 1, 0, activo, text_color = color.white, bgcolor = color.gray)
    table.cell(t, 0, 1, "Tendencia H1", text_color = color.white)
    table.cell(t, 1, 1, tend == 1 ? "ALCISTA" : "BAJISTA", text_color = tend == 1 ? color.green : color.red)
    table.cell(t, 0, 2, "Estado", text_color = color.white)
    table.cell(t, 1, 2, enPosicion ? "EN POSICIÓN" : (not na(pendLimite) ? "ORDEN PENDIENTE" : "SIN OPERAR"), text_color = color.yellow)
    table.cell(t, 0, 3, "Entrada / Límite", text_color = color.white)
    table.cell(t, 1, 3, enPosicion ? str.tostring(entrada, format.mintick) : (not na(pendLimite) ? str.tostring(pendLimite, format.mintick) : "-"), text_color = color.white)
    table.cell(t, 0, 4, "Stop / Objetivo", text_color = color.white)
    table.cell(t, 1, 4, enPosicion ? str.tostring(stop, format.mintick) + " / " + str.tostring(objetivo, format.mintick) : "-", text_color = color.white)
    table.cell(t, 0, 5, "Último resultado", text_color = color.white)
    table.cell(t, 1, 5, na(ultimoR) ? "-" : ultimoResultado + " " + str.tostring(ultimoR, "#.####") + "R",
         text_color = na(ultimoR) ? color.gray : (ultimoR > 0 ? color.green : color.red))
    table.cell(t, 0, 6, "Operaciones (en gráfico)", text_color = color.white)
    table.cell(t, 1, 6, str.tostring(nOps), text_color = color.white)
    table.cell(t, 0, 7, "Winrate", text_color = color.white)
    table.cell(t, 1, 7, na(winrate) ? "-" : str.tostring(winrate, "#.##") + "%",
         text_color = na(winrate) ? color.gray : (winrate >= breakeven ? color.green : color.red))
    table.cell(t, 0, 8, "R/operación · R total", text_color = color.white)
    table.cell(t, 1, 8, na(rProm) ? "-" : str.tostring(rProm, "#.####") + " · " + str.tostring(rTotal, "#.##"),
         text_color = na(rProm) ? color.gray : (rProm > 0 ? color.green : color.red))
    table.cell(t, 0, 9, "Racha actual", text_color = color.white)
    table.cell(t, 1, 9, rachaGanActual > 0 ? str.tostring(rachaGanActual) + " ganando" : (rachaPerdActual > 0 ? str.tostring(rachaPerdActual) + " perdiendo" : "-"),
         text_color = rachaGanActual > 0 ? color.green : (rachaPerdActual > 0 ? color.red : color.gray))
    table.cell(t, 0, 10, "Racha máx. G / P", text_color = color.white)
    table.cell(t, 1, 10, str.tostring(rachaGanMax) + " / " + str.tostring(rachaPerdMax), text_color = color.white)
    table.cell(t, 0, 11, "Drawdown máx · Últimas 5", text_color = color.white)
    table.cell(t, 1, 11, str.tostring(ddMax, "#.##") + "R · " + ultimos5, text_color = color.white)

    // --- capa provisional ---
    table.cell(t, 0, 12, "PRE-SEÑAL", text_color = color.white, bgcolor = color.new(color.orange, 65))
    table.cell(t, 1, 12, preAvisada ? (preValidaAhora ? "ACTIVA" : "APARECIÓ / YA NO") : "SIN PRE-SEÑAL",
         text_color = preValidaAhora ? color.orange : color.gray)
    table.cell(t, 0, 13, "Límite provisional", text_color = color.white)
    table.cell(t, 1, 13, na(preLimiteAct) ? "-" : str.tostring(preLimiteAct, format.mintick), text_color = color.orange)
    table.cell(t, 0, 14, "Detectada en minuto", text_color = color.white)
    table.cell(t, 1, 14, na(preMinutoDet) ? "-" : str.tostring(preMinutoDet) + "/" + str.tostring(minsPorVela), text_color = color.white)
