// This source code is subject to the terms of the Mozilla Public License 2.0
// © El Sensei Pro — Indicador de Estructura, Order Blocks y Probabilidades
//@version=5
indicator("El Sensei Pro", shorttitle="SenseiPro", overlay=true, max_boxes_count=500, max_labels_count=300, max_lines_count=200)

// ═══════════════════════════════════════════════════════════════
// INPUTS — ESTRUCTURA
// ═══════════════════════════════════════════════════════════════
grpEst = "ESTRUCTURA"
leftBars      = input.int(10, "Barras izquierda (pivot)", minval=1, maxval=50, group=grpEst)
rightBars     = input.int(10, "Barras derecha (pivot)",   minval=1, maxval=50, group=grpEst)
showBOS       = input.bool(true,  "Mostrar BOS",   group=grpEst)
showCHoCH     = input.bool(true,  "Mostrar CHoCH", group=grpEst)
useCustomMS   = input.bool(false, "Usar etiqueta personalizada de estructura", group=grpEst)
customMSLabel = input.string("MS", "Etiqueta de estructura de mercado", group=grpEst)

// ═══════════════════════════════════════════════════════════════
// INPUTS — ORDER BLOCKS
// ═══════════════════════════════════════════════════════════════
grpOB = "ORDER BLOCKS"
showOBLabels   = input.bool(true,  "Mostrar etiquetas OB",                    group=grpOB)
showCurrTFOBs  = input.bool(true,  "Mostrar zonas del TF actual",             group=grpOB)
showMTFOBs     = input.bool(true,  "Mostrar zonas MTF",                       group=grpOB)
mtfTF          = input.timeframe("60", "Marco temporal MTF",                  group=grpOB)
obName         = input.string("OB", "Nombre de OB",                           group=grpOB)
obBullColor    = input.color(color.new(color.blue, 70), "Color OB alcista",   group=grpOB)
obBearColor    = input.color(color.new(color.red,  70), "Color OB bajista",   group=grpOB)
obOnlyInStr    = input.bool(true,  "Mostrar OBs solo dentro de la estructura",group=grpOB)
maxOBs         = input.int(5, "Máx. OBs visibles", minval=1, maxval=20,      group=grpOB)

// ═══════════════════════════════════════════════════════════════
// INPUTS — FVG
// ═══════════════════════════════════════════════════════════════
grpFVG = "FVG — FAIR VALUE GAPS"
showFVG      = input.bool(true,  "Mostrar FVG",                               group=grpFVG)
showFVGLbl   = input.bool(true,  "Mostrar etiquetas FVG",                     group=grpFVG)
fvgOnlyInStr = input.bool(true,  "Mostrar FVG solo dentro de la estructura",  group=grpFVG)
fvgLabel     = input.string("FVG", "Texto de etiqueta FVG",                  group=grpFVG)
maxFVG       = input.int(5, "Máx. FVG visibles", minval=1, maxval=20,        group=grpFVG)
fvgBullColor = input.color(color.new(color.green, 80), "Color gap alcista",   group=grpFVG)
fvgBearColor = input.color(color.new(color.red,   80), "Color gap bajista",   group=grpFVG)

// ═══════════════════════════════════════════════════════════════
// INPUTS — PROBABILIDADES
// ═══════════════════════════════════════════════════════════════
grpProb = "PROBABILIDADES"
lookback = input.int(90, "Barras de lookback (zonas similares)", minval=30, maxval=200, group=grpProb)
pipVar   = input.float(5.0, "Variación en pips (similitud de zona)", minval=0.5, step=0.5, group=grpProb)

// ═══════════════════════════════════════════════════════════════
// INPUTS — SESIÓN
// ═══════════════════════════════════════════════════════════════
grpSes = "CONFIGURACIÓN DE SESIÓN A"
showSession   = input.bool(true, "Mostrar sesión A",               group=grpSes)
sessionTime   = input.session("0700-1600", "Horario sesión A",    group=grpSes)
sessBgColor   = input.color(color.new(color.yellow, 92), "Color de fondo sesión", group=grpSes)
sessLineColor = input.color(color.new(color.orange, 20), "Color línea inicio sesión", group=grpSes)

// ═══════════════════════════════════════════════════════════════
// INPUTS — PANEL
// ═══════════════════════════════════════════════════════════════
grpPanel = "PANEL"
showPanel = input.bool(true, "Mostrar panel", group=grpPanel)
panelPos  = input.string("top_right", "Posición del panel",
     options=["top_right","top_left","bottom_right","bottom_left"], group=grpPanel)

// ═══════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════
var float pipSize = syminfo.mintick * 10

// ═══════════════════════════════════════════════════════════════
// PIVOT DETECTION (confirmados, sin repintado — retraso rightBars)
// ═══════════════════════════════════════════════════════════════
pivHigh = ta.pivothigh(high, leftBars, rightBars)
pivLow  = ta.pivotlow(low,   leftBars, rightBars)

bool newPH = not na(pivHigh)
bool newPL = not na(pivLow)

// Guarda los 2 últimos highs y 2 últimos lows confirmados
var float ph0 = na   // pivot high más reciente
var float ph1 = na   // pivot high anterior
var float pl0 = na   // pivot low más reciente
var float pl1 = na   // pivot low anterior
var int   lastPHBar = na
var int   lastPLBar = na

if newPH
    ph1 := ph0
    ph0 := pivHigh
    lastPHBar := bar_index - rightBars

if newPL
    pl1 := pl0
    pl0 := pivLow
    lastPLBar := bar_index - rightBars

// ═══════════════════════════════════════════════════════════════
// ESTRUCTURA — HH / HL / LH / LL (basado en últimos 2 pivots)
// ═══════════════════════════════════════════════════════════════
bool isHH = not na(ph0) and not na(ph1) and ph0 > ph1
bool isLH = not na(ph0) and not na(ph1) and ph0 < ph1
bool isHL = not na(pl0) and not na(pl1) and pl0 > pl1
bool isLL = not na(pl0) and not na(pl1) and pl0 < pl1

// Tendencia basada en los 2 últimos pivots (no acumulativa — se actualiza)
var int    trendDir    = 0   // 1=alcista, -1=bajista, 0=neutral
var int    bosStreak   = 0   // pivots consecutivos confirmando tendencia
var int    validHighs  = 0   // máximos válidos desde último CHoCH
var int    validLows   = 0   // mínimos válidos desde último CHoCH
var string estado      = "Neutralización"
var float  curHH       = na
var float  curHL       = na
var float  curLH       = na
var float  curLL       = na

// Solo actualizar en nuevos pivots
if newPH or newPL
    prevTrend = trendDir

    // Determinar tendencia por los 2 últimos pivots
    if isHH and isHL
        trendDir := 1
    else if isLH and isLL
        trendDir := -1
    else if isHH or isHL
        trendDir := 1
    else if isLH or isLL
        trendDir := -1

    // Racha: reset si cambió la tendencia, suma si confirma
    if trendDir != prevTrend
        bosStreak  := 1
        validHighs := 0
        validLows  := 0
    else
        bosStreak := bosStreak + 1

    // Actualizar valores actuales
    if newPH
        if isHH
            curHH      := ph0
            validHighs := validHighs + 1
        else
            curLH := ph0
    if newPL
        if isHL
            curHL     := pl0
            validLows := validLows + 1
        else
            curLL := pl0

// Estado de la estructura
if trendDir == 1
    estado := (isHH and isHL) ? "Confirmado alcista" : newPH ? "Validando máx." : "Validando mín."
else if trendDir == -1
    estado := (isLH and isLL) ? "Confirmado bajista" : newPL ? "Validando mín." : "Validando máx."
else
    estado := "Neutralización"

// ═══════════════════════════════════════════════════════════════
// BOS & CHoCH — con deduplicación correcta
// ═══════════════════════════════════════════════════════════════
var float bosLevelUp   = na
var float bosLevelDn   = na
var float chochLevelUp = na
var float chochLevelDn = na
var bool  newBOSUp     = false
var bool  newBOSDn     = false
var bool  newCHoCHUp   = false
var bool  newCHoCHDn   = false

// Reset cada barra (señales de un solo pulso)
newBOSUp   := false
newBOSDn   := false
newCHoCHUp := false
newCHoCHDn := false

// BOS alcista: cierre sobre último pivot high en tendencia alcista
if not na(ph0) and close > ph0 and trendDir == 1
    if na(bosLevelUp) or ph0 != bosLevelUp
        bosLevelUp := ph0
        newBOSUp   := true

// BOS bajista: cierre bajo último pivot low en tendencia bajista
if not na(pl0) and close < pl0 and trendDir == -1
    if na(bosLevelDn) or pl0 != bosLevelDn
        bosLevelDn := pl0
        newBOSDn   := true

// CHoCH alcista: precio rompe un pivot high estando en tendencia bajista
if not na(ph0) and close > ph0 and trendDir == -1
    if na(chochLevelUp) or ph0 != chochLevelUp
        chochLevelUp := ph0
        newCHoCHUp   := true

// CHoCH bajista: precio rompe un pivot low estando en tendencia alcista
if not na(pl0) and close < pl0 and trendDir == 1
    if na(chochLevelDn) or pl0 != chochLevelDn
        chochLevelDn := pl0
        newCHoCHDn   := true

// Labels de BOS y CHoCH
bosLblTxt   = useCustomMS ? customMSLabel : "BOS"
chochLblTxt = useCustomMS ? customMSLabel : "CHoCH"

if showBOS and newBOSUp
    label.new(bar_index, high, bosLblTxt + " ↑",
     style=label.style_label_down,
     color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)

if showBOS and newBOSDn
    label.new(bar_index, low, bosLblTxt + " ↓",
     style=label.style_label_up,
     color=color.new(color.maroon, 20), textcolor=color.white, size=size.tiny)

if showCHoCH and newCHoCHUp
    label.new(bar_index, high, chochLblTxt + " ↑",
     style=label.style_label_down,
     color=color.new(color.purple, 30), textcolor=color.white, size=size.tiny)

if showCHoCH and newCHoCHDn
    label.new(bar_index, low, chochLblTxt + " ↓",
     style=label.style_label_up,
     color=color.new(color.purple, 30), textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════
// ORDER BLOCKS
// ═══════════════════════════════════════════════════════════════
var box[]   obBoxes     = array.new_box()
var int[]   obDirs      = array.new_int()
var bool[]  obFresh     = array.new_bool()
var bool[]  obBOS       = array.new_bool()
var float[] obMidpoint  = array.new_float()
var bool[]  obCounted   = array.new_bool()  // para contar retest solo una vez

f_addOB(dir, topVal, botVal, isBosOB) =>
    if showCurrTFOBs and (not obOnlyInStr or trendDir == dir)
        obColor = dir == 1 ? obBullColor : obBearColor
        newBox  = box.new(bar_index - 1, topVal, bar_index + 50, botVal,
             border_color=color.new(obColor, 40),
             bgcolor=obColor, extend=extend.right)
        if showOBLabels
            label.new(bar_index - 1, topVal,
             obName + (dir == 1 ? " ↑" : " ↓"),
             style=label.style_label_right,
             color=color.new(obColor, 30),
             textcolor=color.white, size=size.tiny)
        array.push(obBoxes,    newBox)
        array.push(obDirs,     dir)
        array.push(obFresh,    true)
        array.push(obBOS,      isBosOB)
        array.push(obMidpoint, (topVal + botVal) / 2)
        array.push(obCounted,  false)
        while array.size(obBoxes) > maxOBs
            oldBox = array.shift(obBoxes)
            box.delete(oldBox)
            array.shift(obDirs)
            array.shift(obFresh)
            array.shift(obBOS)
            array.shift(obMidpoint)
            array.shift(obCounted)

// Detectar OBs en BOS
if newBOSUp
    obTop2 = math.max(open[1], close[1])
    obBot2 = math.min(open[1], close[1])
    f_addOB(1, obTop2, obBot2, true)

if newBOSDn
    obTop2 = math.max(open[1], close[1])
    obBot2 = math.min(open[1], close[1])
    f_addOB(-1, obTop2, obBot2, true)

// Actualizar frescura e invalidación
if array.size(obBoxes) > 0
    for i = array.size(obBoxes) - 1 to 0
        if i < array.size(obBoxes)
            bx  = array.get(obBoxes, i)
            dir = array.get(obDirs,  i)
            top = box.get_top(bx)
            bot = box.get_bottom(bx)
            // Marcar usado si precio entra en zona
            if close >= bot and close <= top
                array.set(obFresh, i, false)
                box.set_bgcolor(bx, color.new(dir == 1 ? color.blue : color.red, 88))
            // Invalidar si precio cierra al otro lado
            if (dir == 1 and close < bot) or (dir == -1 and close > top)
                box.delete(bx)
                array.remove(obBoxes,    i)
                array.remove(obDirs,     i)
                array.remove(obFresh,    i)
                array.remove(obBOS,      i)
                array.remove(obMidpoint, i)
                array.remove(obCounted,  i)

// ═══════════════════════════════════════════════════════════════
// FVG — FAIR VALUE GAPS (con límite de visibles)
// ═══════════════════════════════════════════════════════════════
var box[] fvgBoxes = array.new_box()
var int[] fvgDirs  = array.new_int()

bullFVG = low > high[2]
bearFVG = high < low[2]

if showFVG
    if bullFVG and (not fvgOnlyInStr or trendDir == 1)
        if array.size(fvgBoxes) < maxFVG
            fb = box.new(bar_index - 2, low, bar_index + 30, high[2],
             border_color=color.new(fvgBullColor, 20),
             bgcolor=fvgBullColor, extend=extend.right)
            array.push(fvgBoxes, fb)
            array.push(fvgDirs,  1)
            if showFVGLbl
                label.new(bar_index - 2, low, fvgLabel + " ↑",
                 style=label.style_label_right,
                 color=color.new(color.green, 30),
                 textcolor=color.white, size=size.tiny)

    if bearFVG and (not fvgOnlyInStr or trendDir == -1)
        if array.size(fvgBoxes) < maxFVG
            fb = box.new(bar_index - 2, low[2], bar_index + 30, high,
             border_color=color.new(fvgBearColor, 20),
             bgcolor=fvgBearColor, extend=extend.right)
            array.push(fvgBoxes, fb)
            array.push(fvgDirs, -1)
            if showFVGLbl
                label.new(bar_index - 2, high, fvgLabel + " ↓",
                 style=label.style_label_right,
                 color=color.new(color.red, 30),
                 textcolor=color.white, size=size.tiny)

// Eliminar FVGs llenados
if array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        if i < array.size(fvgBoxes)
            bx  = array.get(fvgBoxes, i)
            dir = array.get(fvgDirs,  i)
            top = box.get_top(bx)
            bot = box.get_bottom(bx)
            if (dir == 1 and low <= bot) or (dir == -1 and high >= top)
                box.delete(bx)
                array.remove(fvgBoxes, i)
                array.remove(fvgDirs,  i)

// ═══════════════════════════════════════════════════════════════
// PROBABILIDADES (aproximación de la fórmula del Sensei)
// Busca las últimas `lookback` velas con cuerpos similares,
// comprueba si hubo retest y continuación
// ═══════════════════════════════════════════════════════════════
f_calcProb(dir) =>
    totalSimilar = 0
    totalRetest  = 0
    totalCont    = 0
    zoneSize     = pipVar * pipSize
    for j = 1 to lookback
        if j < bar_index
            cBody    = math.abs(close[j] - open[j])
            matchDir = (dir == 1 and close[j] < open[j]) or (dir == -1 and close[j] > open[j])
            if matchDir and cBody <= zoneSize * 5 and cBody >= zoneSize * 0.2
                totalSimilar := totalSimilar + 1
                cTop = math.max(close[j], open[j])
                cBot = math.min(close[j], open[j])
                didRetest   = false
                didContinue = false
                maxK = math.max(j - 15, 1)
                for k = j - 1 to maxK
                    if not didContinue
                        if low[k] <= cTop and high[k] >= cBot
                            didRetest := true
                        if didRetest
                            if dir == 1 and close[k] > cTop
                                didContinue := true
                            if dir == -1 and close[k] < cBot
                                didContinue := true
                if didRetest
                    totalRetest := totalRetest + 1
                if didContinue
                    totalCont := totalCont + 1
    cRate = totalSimilar > 0 ? math.min(100.0, totalCont  * 100.0 / totalSimilar) : 50.0
    rRate = totalSimilar > 0 ? math.min(100.0, totalRetest * 100.0 / totalSimilar) : 50.0
    [cRate, rRate, totalSimilar]

[contRateBull, retestBull, simBull] = f_calcProb(1)
[contRateBear, retestBear, simBear] = f_calcProb(-1)

float contRateActive = trendDir == 1 ? contRateBull : trendDir == -1 ? contRateBear : 50.0

// BOS retest: contar solo la PRIMERA vez que un OB BOS pasa de fresco a usado
// (obCounted evita contar el mismo OB cada barra)
var int bosBullTotal  = 0
var int bosBullRetest = 0
var int bosBearTotal  = 0
var int bosBearRetest = 0

if newBOSUp
    bosBullTotal := bosBullTotal + 1
if newBOSDn
    bosBearTotal := bosBearTotal + 1

if array.size(obBoxes) > 0
    for i = 0 to array.size(obBoxes) - 1
        if i < array.size(obBoxes)
            if array.get(obBOS, i) and not array.get(obFresh, i) and not array.get(obCounted, i)
                array.set(obCounted, i, true)
                if array.get(obDirs, i) == 1
                    bosBullRetest := bosBullRetest + 1
                else
                    bosBearRetest := bosBearRetest + 1

float retestBOSUp = bosBullTotal > 0 ? math.min(100.0, bosBullRetest * 100.0 / bosBullTotal) : 50.0
float retestBOSDn = bosBearTotal > 0 ? math.min(100.0, bosBearRetest * 100.0 / bosBearTotal) : 50.0

// ═══════════════════════════════════════════════════════════════
// MTF
// ═══════════════════════════════════════════════════════════════
[mtfClose, mtfOpen, mtfHigh, mtfLow] = request.security(syminfo.tickerid, mtfTF,
     [close, open, high, low], lookahead=barmerge.lookahead_off)

mtfBullish = mtfClose > mtfOpen and mtfHigh > mtfHigh[1]
mtfBearish = mtfClose < mtfOpen and mtfLow  < mtfLow[1]
int mtfDir = mtfBullish ? 1 : mtfBearish ? -1 : 0

[mtfContBull, mtfRetBull, mtfSimBull] = request.security(syminfo.tickerid, mtfTF,
     f_calcProb(1), lookahead=barmerge.lookahead_off)
[mtfContBear, mtfRetBear, mtfSimBear] = request.security(syminfo.tickerid, mtfTF,
     f_calcProb(-1), lookahead=barmerge.lookahead_off)

float mtfContRate  = mtfDir == 1 ? mtfContBull : mtfDir == -1 ? mtfContBear : 50.0
bool  mtfAligned   = (trendDir == 1 and mtfDir == 1) or (trendDir == -1 and mtfDir == -1)
bool  mtfContra    = (trendDir == 1 and mtfDir == -1) or (trendDir == -1 and mtfDir == 1)
bool  mtfNeutral   = mtfContRate >= 45.0 and mtfContRate <= 55.0

// ═══════════════════════════════════════════════════════════════
// CALIFICACIÓN (1–5 estrellas)
// ═══════════════════════════════════════════════════════════════
int rating = 0
if contRateActive > 65.0
    rating := rating + 2
else if contRateActive > 50.0
    rating := rating + 1
if mtfAligned
    rating := rating + 1
bool freshZone = false
if array.size(obBoxes) > 0
    for i = 0 to array.size(obBoxes) - 1
        if i < array.size(obBoxes)
            if array.get(obFresh, i) and array.get(obDirs, i) == trendDir
                freshZone := true
if freshZone
    rating := rating + 1
if trendDir != 0
    rating := rating + 1
if mtfContra
    rating := rating - 2
rating := math.max(0, math.min(5, rating))

f_stars(r) =>
    r == 5 ? "★★★★★" : r == 4 ? "★★★★☆" : r == 3 ? "★★★☆☆" : r == 2 ? "★★☆☆☆" : r == 1 ? "★☆☆☆☆" : "☆☆☆☆☆"

starsStr = f_stars(rating)

// ═══════════════════════════════════════════════════════════════
// SESIÓN
// ═══════════════════════════════════════════════════════════════
inSession = not na(time(timeframe.period, sessionTime))
bgcolor(showSession and inSession ? sessBgColor : na, title="Fondo sesión A")

var bool prevInSess = false
if showSession and inSession and not prevInSess
    line.new(bar_index, low * 0.999, bar_index, high * 1.001,
     color=sessLineColor, width=1, style=line.style_dashed, extend=extend.both)
prevInSess := inSession

// ═══════════════════════════════════════════════════════════════
// MTF OB BOXES
// ═══════════════════════════════════════════════════════════════
var box[] mtfOBBoxes = array.new_box()
var int[] mtfOBDirs  = array.new_int()

mtfBullOB = request.security(syminfo.tickerid, mtfTF, newBOSUp, lookahead=barmerge.lookahead_off)
mtfBearOB = request.security(syminfo.tickerid, mtfTF, newBOSDn, lookahead=barmerge.lookahead_off)
mtfObH    = request.security(syminfo.tickerid, mtfTF, high[1],  lookahead=barmerge.lookahead_off)
mtfObL    = request.security(syminfo.tickerid, mtfTF, low[1],   lookahead=barmerge.lookahead_off)

if showMTFOBs
    if mtfBullOB
        nb = box.new(bar_index, mtfObH, bar_index + 80, mtfObL,
         border_color=color.new(obBullColor, 20),
         bgcolor=color.new(obBullColor, 60), extend=extend.right)
        array.push(mtfOBBoxes, nb)
        array.push(mtfOBDirs,  1)
    if mtfBearOB
        nb = box.new(bar_index, mtfObH, bar_index + 80, mtfObL,
         border_color=color.new(obBearColor, 20),
         bgcolor=color.new(obBearColor, 60), extend=extend.right)
        array.push(mtfOBBoxes, nb)
        array.push(mtfOBDirs, -1)
    while array.size(mtfOBBoxes) > maxOBs
        box.delete(array.shift(mtfOBBoxes))
        array.shift(mtfOBDirs)

// ═══════════════════════════════════════════════════════════════
// PANEL TABLE
// ═══════════════════════════════════════════════════════════════
clrHeader  = color.new(#1a2744, 0)
clrSection = color.new(#1e3a5f, 0)
clrBg      = color.new(#0d1b2a, 10)
clrText    = color.white
clrGreen   = #26a69a
clrRed     = #ef5350
clrOrange  = #ff9800
clrGold    = #ffd700

tblPos = panelPos == "top_right"    ? position.top_right    :
         panelPos == "top_left"     ? position.top_left     :
         panelPos == "bottom_right" ? position.bottom_right :
         position.bottom_left

var table panel = table.new(tblPos, 2, 22,
     border_color=color.new(color.gray, 60), border_width=1,
     frame_color=color.new(color.gray, 40), frame_width=1)

f_pct(v) => str.tostring(math.round(v, 1)) + "%"

f_dir(d) => d == 1 ? "Alcista ▲" : d == -1 ? "Bajista ▼" : "Neutral —"

f_dirClr(d) => d == 1 ? clrGreen : d == -1 ? clrRed : clrOrange

f_rateClr(v) => v > 55.0 ? clrGreen : v < 45.0 ? clrRed : clrOrange

if showPanel and barstate.islast
    // Fila 0 — Cabecera
    table.cell(panel, 0, 0, "El Sensei Pro", bgcolor=clrHeader,
     text_color=clrGold, text_size=size.small, text_halign=text.align_center)
    table.cell(panel, 1, 0, "v2.0", bgcolor=clrHeader,
     text_color=color.new(color.gray, 30), text_size=size.tiny, text_halign=text.align_right)

    // Fila 1 — Sección ESTRUCTURA
    table.cell(panel, 0, 1, "— ESTRUCTURA —", bgcolor=clrSection,
     text_color=color.new(color.silver, 0), text_size=size.tiny, text_halign=text.align_center)
    table.cell(panel, 1, 1, "", bgcolor=clrSection, text_color=clrText, text_size=size.tiny)

    // Tendencia
    table.cell(panel, 0, 2, "Tendencia", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 2, f_dir(trendDir), bgcolor=clrBg,
     text_color=f_dirClr(trendDir), text_size=size.tiny)

    // Máximos válidos (desde último CHoCH)
    table.cell(panel, 0, 3, "Máx. válidos", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 3, str.tostring(validHighs), bgcolor=clrBg,
     text_color=clrGreen, text_size=size.tiny)

    // Mínimos válidos
    table.cell(panel, 0, 4, "Mín. válidos", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 4, str.tostring(validLows), bgcolor=clrBg,
     text_color=clrGreen, text_size=size.tiny)

    // HH actual
    hhStr = not na(curHH) ? str.tostring(math.round(curHH, 5)) : "—"
    table.cell(panel, 0, 5, "HH actual", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 5, hhStr, bgcolor=clrBg, text_color=clrGreen, text_size=size.tiny)

    // HL actual
    hlStr = not na(curHL) ? str.tostring(math.round(curHL, 5)) : "—"
    table.cell(panel, 0, 6, "HL actual", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 6, hlStr, bgcolor=clrBg, text_color=clrGreen, text_size=size.tiny)

    // LH actual
    lhStr = not na(curLH) ? str.tostring(math.round(curLH, 5)) : "—"
    table.cell(panel, 0, 7, "LH actual", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 7, lhStr, bgcolor=clrBg, text_color=clrRed, text_size=size.tiny)

    // LL actual
    llStr = not na(curLL) ? str.tostring(math.round(curLL, 5)) : "—"
    table.cell(panel, 0, 8, "LL actual", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 8, llStr, bgcolor=clrBg, text_color=clrRed, text_size=size.tiny)

    // Estado
    eBg = estado == "Confirmado alcista" ? color.new(clrGreen, 60) :
          estado == "Confirmado bajista" ? color.new(clrRed,   60) :
          color.new(clrOrange, 60)
    table.cell(panel, 0, 9, "Estado", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 9, estado, bgcolor=eBg, text_color=clrText, text_size=size.tiny)

    // Fila 10 — Sección PROBABILIDADES
    table.cell(panel, 0, 10, "— PROBABILIDADES —", bgcolor=clrSection,
     text_color=color.new(color.silver, 0), text_size=size.tiny, text_halign=text.align_center)
    table.cell(panel, 1, 10, "", bgcolor=clrSection, text_color=clrText, text_size=size.tiny)

    // Tasa continuación
    table.cell(panel, 0, 11, "Tasa continuación", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 11, f_pct(contRateActive), bgcolor=clrBg,
     text_color=f_rateClr(contRateActive), text_size=size.tiny)

    // Racha tendencia
    table.cell(panel, 0, 12, "Racha tendencia", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 12, str.tostring(bosStreak), bgcolor=clrBg,
     text_color=trendDir == 1 ? clrGreen : trendDir == -1 ? clrRed : clrOrange, text_size=size.tiny)

    // Retest BOS ↑
    table.cell(panel, 0, 13, "Retest BOS ↑", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 13, f_pct(retestBOSUp), bgcolor=clrBg,
     text_color=f_rateClr(retestBOSUp), text_size=size.tiny)

    // Retest ↑
    table.cell(panel, 0, 14, "Retest ↑", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 14, f_pct(retestBull), bgcolor=clrBg,
     text_color=f_rateClr(retestBull), text_size=size.tiny)

    // Retest BOS ↓
    table.cell(panel, 0, 15, "Retest BOS ↓", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 15, f_pct(retestBOSDn), bgcolor=clrBg,
     text_color=f_rateClr(retestBOSDn), text_size=size.tiny)

    // Retest ↓
    table.cell(panel, 0, 16, "Retest ↓", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 16, f_pct(retestBear), bgcolor=clrBg,
     text_color=f_rateClr(retestBear), text_size=size.tiny)

    // Calificación
    rBg = rating >= 4 ? color.new(clrGreen, 50) :
          rating >= 3 ? color.new(clrOrange, 50) :
          color.new(clrRed, 50)
    table.cell(panel, 0, 17, "Calificación", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 17, starsStr, bgcolor=rBg, text_color=clrGold, text_size=size.small)

    // Fila 18 — Sección MTF
    mtfHdr = "— MTF [" + mtfTF + "] —"
    table.cell(panel, 0, 18, mtfHdr, bgcolor=clrSection,
     text_color=color.new(color.silver, 0), text_size=size.tiny, text_halign=text.align_center)
    table.cell(panel, 1, 18, "", bgcolor=clrSection, text_color=clrText, text_size=size.tiny)

    // MTF Tendencia
    mtfSt  = mtfNeutral ? "Neutralización" : f_dir(mtfDir)
    mtfTxC = mtfNeutral ? clrOrange : f_dirClr(mtfDir)
    table.cell(panel, 0, 19, "MTF Tendencia", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 19, mtfSt, bgcolor=clrBg, text_color=mtfTxC, text_size=size.tiny)

    // MTF Tasa cont.
    table.cell(panel, 0, 20, "MTF Tasa cont.", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 20, f_pct(mtfContRate), bgcolor=clrBg,
     text_color=f_rateClr(mtfContRate), text_size=size.tiny)

    // Alineación MTF
    aStr = mtfAligned ? "Alineado ✓" : mtfContra ? "Contradice ✗" : "Neutral —"
    aClr = mtfAligned ? clrGreen : mtfContra ? clrRed : clrOrange
    aBg  = mtfAligned ? color.new(clrGreen, 70) : mtfContra ? color.new(clrRed, 70) : color.new(clrOrange, 70)
    table.cell(panel, 0, 21, "Alineación", bgcolor=clrBg,
     text_color=color.new(color.silver, 20), text_size=size.tiny)
    table.cell(panel, 1, 21, aStr, bgcolor=aBg, text_color=aClr, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════
// PLOTS — puntos de pivots confirmados
// ═══════════════════════════════════════════════════════════════
plotshape(newPH, title="Pivot High", style=shape.triangledown,
 location=location.abovebar, color=color.new(color.red, 40), size=size.tiny)
plotshape(newPL, title="Pivot Low", style=shape.triangleup,
 location=location.belowbar, color=color.new(color.teal, 40), size=size.tiny)

// ═══════════════════════════════════════════════════════════════
// ALERTAS
// ═══════════════════════════════════════════════════════════════
alertcondition(newBOSUp,   title="BOS Alcista",  message="El Sensei Pro — BOS alcista detectado")
alertcondition(newBOSDn,   title="BOS Bajista",  message="El Sensei Pro — BOS bajista detectado")
alertcondition(newCHoCHUp, title="CHoCH Alcista", message="El Sensei Pro — CHoCH alcista detectado")
alertcondition(newCHoCHDn, title="CHoCH Bajista", message="El Sensei Pro — CHoCH bajista detectado")
alertcondition(bullFVG and showFVG, title="FVG Alcista", message="El Sensei Pro — FVG alcista formado")
alertcondition(bearFVG and showFVG, title="FVG Bajista", message="El Sensei Pro — FVG bajista formado")
alertcondition(rating >= 4 and trendDir == 1,  title="Setup Alcista Alta Calidad", message="El Sensei Pro — Setup alcista 4-5 estrellas")
alertcondition(rating >= 4 and trendDir == -1, title="Setup Bajista Alta Calidad", message="El Sensei Pro — Setup bajista 4-5 estrellas")
alertcondition(contRateActive < 50.0 and trendDir != 0, title="Probabilidad Baja", message="El Sensei Pro — Tasa de continuacion por debajo del 50%")
alertcondition(mtfNeutral, title="Neutralizacion MTF", message="El Sensei Pro — MTF en neutralizacion, evitar operar")
